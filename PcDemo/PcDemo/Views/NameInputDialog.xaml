<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="PcDemo.Views.NameInputDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="重命名"
    PrimaryButtonText="保存"
    CloseButtonText="取消"
    DefaultButton="Primary">

    <StackPanel Width="360" Spacing="10">
        <TextBlock Text="输入新的显示名称（仅本地生效，不影响对方设备上的名字）。"
                   FontSize="12" Opacity="0.65" TextWrapping="Wrap"/>
        <TextBox x:Name="InputBox" PlaceholderText="输入名称" MaxLength="60" FontSize="14"/>
    </StackPanel>
</ContentDialog>
