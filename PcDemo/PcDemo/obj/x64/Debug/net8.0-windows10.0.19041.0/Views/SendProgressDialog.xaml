<?xml version="1.0" encoding="utf-8"?>
<!-- 发送进度对话框：环形进度 + 状态/速度/剩余时间；PrimaryButton"取消传输" → 二次确认面板（不关闭对话框） -->
<ContentDialog x:ConnectionId='1'
    x:Class="PcDemo.Views.SendProgressDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:PcDemo.Converters"
    Title="正在发送"
    PrimaryButtonText="取消传输"
                                      
                                          >

    <Grid MinWidth="400">
        <!-- 进度面板：二次确认时保持显示（确认按钮在底部命令区切换） -->
        <StackPanel Spacing="14" Padding="0,4,0,0">
            <TextBlock x:ConnectionId='2'                                         FontSize="14" Opacity="0.8"
                       HorizontalAlignment="Center"/>
            <ProgressRing x:ConnectionId='3' Width="84" Height="84"
                                                                           
                                                                 />
            <StackPanel Spacing="4" HorizontalAlignment="Center">
                <TextBlock x:ConnectionId='4'                                        FontSize="15" FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock x:ConnectionId='5'                                        FontSize="12" Opacity="0.7"
                           HorizontalAlignment="Center"/>
                <TextBlock x:ConnectionId='6'                                       FontSize="12" Opacity="0.75"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</ContentDialog>

