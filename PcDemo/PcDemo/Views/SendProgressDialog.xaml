<?xml version="1.0" encoding="utf-8"?>
<!--
  发送进度对话框（design/unified v1.3 FileProgressList）
  两层口径：总进度按「已传字节 / 总字节」，每个文件一条独立进度条。
  文件清单放在独立的 ScrollViewer（MaxHeight=240）里，文件再多也只滚列表，
  总进度区与底部按钮保持固定。单发/群发两种面板共用同一套视觉令牌。
-->
<ContentDialog
    x:Class="PcDemo.Views.SendProgressDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="正在发送"
    PrimaryButtonText="取消传输"
    PrimaryButtonClick="OnCancelClick"
    SecondaryButtonClick="OnContinueClick">

    <Grid MinWidth="480">
        <!-- 单发面板：总进度 + 逐文件进度清单 -->
        <StackPanel x:Name="SinglePanel" Spacing="{StaticResource GapBlock}" Padding="0,4,0,0">
            <Border HorizontalAlignment="Left" Padding="{StaticResource SpaceChip}"
                    CornerRadius="{StaticResource RadiusControl}"
                    Background="{ThemeResource ChipFillBrush}">
                <TextBlock x:Name="TargetTextBlock" FontSize="{StaticResource FontSm}"
                           Foreground="{ThemeResource BrandTextDimBrush}"/>
            </Border>

            <!-- 总进度：环形 + 大百分比 + 线性条 + 字节/速度 -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource GapSection}">
                <Grid Width="96" Height="96" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressRing x:Name="ProgressRingControl" Width="96" Height="96"
                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                  Background="{ThemeResource ControlStrokeColorSecondaryBrush}"/>
                    <TextBlock x:Name="RingPercentTextBlock" FontSize="{StaticResource FontH1}" FontWeight="SemiBold"
                               Foreground="{ThemeResource BrandTextBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel Grid.Column="1" Spacing="{StaticResource GapMicro}" VerticalAlignment="Center">
                    <TextBlock x:Name="StateTextBlock" FontSize="{StaticResource FontH2}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="FilesTextBlock" FontSize="{StaticResource FontSm}"
                               Foreground="{ThemeResource BrandTextDimBrush}"/>
                    <TextBlock x:Name="StatTextBlock" FontSize="{StaticResource FontSm}"
                               Foreground="{ThemeResource BrandTextDimBrush}"/>
                    <ProgressBar x:Name="TotalProgressBar" Height="8" Maximum="100" Minimum="0" Value="0"
                                 CornerRadius="{StaticResource RadiusXs}"
                                 Foreground="{ThemeResource BrandAccentFillBrush}"
                                 Background="{ThemeResource BrandSurface3Brush}"
                                 AutomationProperties.Name="总进度（按字节）"/>
                </StackPanel>
            </Grid>

            <!-- 文件进度：每个文件一条独立进度条 -->
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="{StaticResource GapControl}">
                <TextBlock Text="文件进度" Style="{StaticResource SectionTitleStyle}"/>
                <Border Padding="{StaticResource SpaceChip}" CornerRadius="{StaticResource RadiusControl}"
                        Background="{ThemeResource ChipFillBrush}">
                    <TextBlock x:Name="FileCountTextBlock" Text="0" FontSize="{StaticResource FontLabel}"
                               Foreground="{ThemeResource BrandTextDimBrush}"/>
                </Border>
                <TextBlock Text="按队列顺序传输" Style="{StaticResource CaptionTextStyle}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
            <ScrollViewer x:Name="FileListScroll" MaxHeight="{StaticResource FileListMaxHeight}"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="FileListPanel" Spacing="{StaticResource GapControl}"/>
            </ScrollViewer>
        </StackPanel>

        <!-- 群发面板：每台一行（设备名+状态+迷你进度条），顶部汇总 -->
        <StackPanel x:Name="BatchPanel" Visibility="Collapsed" Spacing="{StaticResource GapControl}" Padding="0,4,0,0">
            <TextBlock x:Name="BatchSummaryTextBlock" FontSize="{StaticResource FontBody}" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Foreground="{ThemeResource BrandTextBrush}"/>
            <!-- MaxHeight 在 code-behind 按窗口高度动态适配（Opened 时），避免设备多时弹窗超出界面 -->
            <ScrollViewer x:Name="BatchListScroll" MaxHeight="330"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="BatchListPanel" Spacing="{StaticResource GapControl}"/>
            </ScrollViewer>
        </StackPanel>
    </Grid>
</ContentDialog>
