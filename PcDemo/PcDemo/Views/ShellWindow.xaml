<?xml version="1.0" encoding="utf-8"?>
<!-- 主窗口：顶部标题栏（图标+应用名）+ NavigationView（接收/设置）+ Frame 内容区 -->
<Window
    x:Class="PcDemo.Views.ShellWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="LocalSend PC">

    <Grid x:Name="RootGrid" RowDefinitions="48,*">
        <!-- 自定义标题栏：汉堡按钮（收起/展开侧边栏）+ 应用图标 + 名称 -->
        <Grid x:Name="AppTitleBar" Grid.Row="0"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              Padding="4,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- 侧边栏收起/展开按钮（最左） -->
            <Button x:Name="PaneToggleButton" Grid.Column="0"
                    Click="OnPaneToggleClick"
                    ToolTipService.ToolTip="收起/展开侧边栏"
                    Background="Transparent" BorderThickness="0"
                    Width="44" Height="40" Padding="0">
                <SymbolIcon Symbol="GlobalNavigationButton"/>
            </Button>
            <Image Grid.Column="1" Source="Assets/Square44x44Logo.targetsize-24_altform-unplated.png"
                   Width="22" Height="22" Margin="4,0,0,0" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="LocalSend PC" FontSize="13" FontWeight="SemiBold"
                       Margin="12,0,0,0" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
        </Grid>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            PaneDisplayMode="Left"
            OpenPaneLength="160"
            CompactPaneLength="48"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            SelectionChanged="OnSelectionChanged">
            <NavigationView.Resources>
                <!-- 侧边栏背景：LayerFillColorDefaultBrush 与标题栏一致，形成同色条 -->
                <SolidColorBrush x:Key="NavigationViewPaneBackground"
                                 Color="{ThemeResource LayerFillColorDefaultColor}"
                                 Opacity="1.0"/>
            </NavigationView.Resources>

            <NavigationView.MenuItems>
                <NavigationViewItem Tag="Receive" Icon="Download" Content="接收"/>
                <NavigationViewItem Tag="Send" Icon="Send" Content="发送"/>
                <NavigationViewItem Tag="DeviceList" Icon="People" Content="设备管理"/>
                <NavigationViewItem Tag="History" Icon="Clock" Content="历史记录"/>
            </NavigationView.MenuItems>

            <!-- 底部 footer 菜单项（独立于顶部 MenuItems，会贴在侧边栏底部）-->
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Tag="Settings" Icon="Setting" Content="设置"/>
            </NavigationView.FooterMenuItems>

            <!-- Frame 作为 NavigationView 的隐式 Content（内容区），
                 用稍不同的 LayerOnMicaBaseAltFillColorTransparentBrush 形成与侧边栏的色差 -->
            <Frame x:Name="ContentFrame"
                   Background="{ThemeResource LayerOnMicaBaseAltFillColorTransparentBrush}"/>
        </NavigationView>
    </Grid>
</Window>
