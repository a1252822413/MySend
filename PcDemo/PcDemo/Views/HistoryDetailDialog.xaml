<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="PcDemo.Views.HistoryDetailDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="传输详情"
    PrimaryButtonText="关闭"
    DefaultButton="Primary">

    <Grid Width="560" MaxHeight="520">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="3">
            <TextBlock x:Name="HeaderText" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="SubText" FontSize="11.5" Opacity="0.6" TextWrapping="Wrap"/>
        </StackPanel>

        <TextBlock Grid.Row="1" x:Name="ListCaption" Text="文件清单" FontSize="12" Opacity="0.65"
                   Margin="0,12,0,6"/>

        <TextBlock Grid.Row="2" x:Name="NoDetailsText" Text="该记录没有逐文件明细（旧版本生成）。"
                   FontSize="12" Opacity="0.5" Margin="0,4,0,8" Visibility="Collapsed"/>

        <ListView Grid.Row="3" x:Name="FileList" SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,6"/>
                    <Setter Property="MinHeight" Value="0"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10,8" CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            ToolTipService.ToolTip="{Binding Error}">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="{Binding FileName}" FontSize="13"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTipService.ToolTip="{Binding FileName}"/>
                                <TextBlock Text="{Binding SizeText}" FontSize="11" Opacity="0.55"/>
                            </StackPanel>
                            <Border Grid.Column="1" Padding="8,3" CornerRadius="8" VerticalAlignment="Center"
                                    Background="{Binding StatusBrush}">
                                <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="White"/>
                            </Border>
                            <Button Grid.Column="2" Content="打开位置" Click="OnOpenDetailFileClick"
                                    Padding="8,4" CornerRadius="6" FontSize="11" VerticalAlignment="Center"
                                    Visibility="{Binding OpenVisibility}"
                                    ToolTipService.ToolTip="在资源管理器中显示该文件"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</ContentDialog>
