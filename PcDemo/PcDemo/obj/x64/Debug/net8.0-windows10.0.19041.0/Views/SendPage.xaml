<?xml version="1.0" encoding="utf-8"?>
<Page x:ConnectionId='1'
    x:Class="PcDemo.Views.SendPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PcDemo.ViewModels"
    xmlns:c="using:PcDemo.Converters"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
    Background="Transparent"
    AllowDrop="True"
                         
                           
                 >
    <Page.Resources>
        <c:FileKindToGlyphConverter x:Key="FileKindGlyph"/>
        <c:NullToCollapsed x:Key="NullToCollapsed"/>
        <c:BytesToString x:Key="BytesToString"/>
        <c:DoubleToPercent x:Key="DoubleToPercent"/>
        <c:DoubleToPercentText x:Key="DoubleToPercentText"/>
        <c:FailedToVisible x:Key="FailedToVisible"/>
        <c:PendingOnlyToVisible x:Key="PendingOnlyToVisible"/>
        <c:SendFileStatusToColor x:Key="StatusColor"/>
        <c:SendFileStatusToProgressColor x:Key="ProgressColor"/>
        <c:ShowProgressBarWhenInProgressOrDone x:Key="ShowProgress"/>
        <c:BoolToPassColor x:Key="BoolToPassColor"/>
        <c:BoolToHintColor x:Key="BoolToHintColor"/>
        <c:BoolToReadyTarget x:Key="BoolToReadyTarget"/>
        <c:BoolToReadyFile x:Key="BoolToReadyFile"/>
        <c:BoolToReadyState x:Key="BoolToReadyState"/>
        <c:BoolToOnlineDot x:Key="BoolToOnlineDot"/>
        <c:BoolToOnlineLabel x:Key="BoolToOnlineLabel"/>
        <c:DeviceTypeToGlyphConverter x:Key="DeviceTypeGlyph"/>
        <c:SendSessionStateToText x:Key="StateText"/>
        <c:BoolToSelectionBrush x:Key="PickBrush"/>
        <c:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
        <c:RefreshingTextConverter x:Key="RefreshingTextConverter"/>
    </Page.Resources>

    <Grid x:ConnectionId='2' Padding="24" RowDefinitions="Auto,Auto,*" Background="Transparent"
          AllowDrop="True"                                                            >
        <Border x:ConnectionId='3' x:Name="DropHighlightBorder" Margin="0" CornerRadius="14"
                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                BorderThickness="2" Background="{ThemeResource AccentFillColorDefaultBrush}"
                Opacity="0" IsHitTestVisible="False"/>

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="发送文件" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="选择目标设备和要发送的文件" FontSize="12" Opacity="0.6"/>
            </StackPanel>
        </Grid>

            <InfoBar x:ConnectionId='4'
                Grid.Row="0"
                Grid.RowSpan="3"
                VerticalAlignment="Top"
                HorizontalAlignment="Stretch"
                                                                           
                                                                         
                                                                             
                                                                               
                IsClosable="True"
                Margin="0,0,0,0"
                CornerRadius="8"/>

            <Grid Grid.Row="1" Margin="0,24,0,0" RowDefinitions="Auto,Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="选择目标设备" FontSize="16" FontWeight="SemiBold"/>
                        <Border Padding="8,2" CornerRadius="10" Background="{ThemeResource CardStrokeColorDefaultBrush}">
                            <TextBlock x:ConnectionId='44'                                                      FontSize="11" Opacity="0.7"/>
                        </Border>
                    </StackPanel>
                    <Button x:ConnectionId='41' Grid.Column="1"                                                   
                                                                                                                         
                            Padding="8" Background="Transparent" BorderThickness="0"
                            ToolTipService.ToolTip="重新搜索（每 20 秒自动刷新）">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ProgressRing x:ConnectionId='42' Width="14" Height="14"                                           />
                            <TextBlock x:ConnectionId='43'                                                                                            FontSize="12"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Border x:ConnectionId='32' Grid.Row="1" Margin="0,12,0,16" Padding="14,10" CornerRadius="10"
                        Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.9"
                                                                                                                  >
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="🎯" FontSize="16"/>
                            <StackPanel Spacing="2">
                                <TextBlock x:ConnectionId='37'                                                            
                                           FontWeight="SemiBold" FontSize="13"/>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="🌐" FontSize="10" Opacity="0.8" VerticalAlignment="Center"/>
                                    <TextBlock FontSize="11" Opacity="0.85" VerticalAlignment="Center">
                                        <Run x:ConnectionId='38'                                                         />
                                        <Run Text="·"/>
                                        <Run x:ConnectionId='39'                                                           />
                                        <Run Text="·"/>
                                        <Run x:ConnectionId='40'                                                                  />
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <Button x:ConnectionId='36' Grid.Column="1" Content="更换" Padding="10,4" FontSize="12"
                                                              Background="Transparent"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                    </Grid>
                </Border>

                <ListView x:ConnectionId='33' Grid.Row="2"
                                                                  
                          SelectionMode="Single"
                                                                                       
                                                                                 >
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal"
                                           ItemWidth="280" ItemHeight="120" MaximumRowsOrColumns="10"/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,10,10"/>
                            <Setter Property="MinHeight" Value="0"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="14" CornerRadius="12"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{Binding IsPicked, Mode=OneWay, Converter={StaticResource PickBrush}}"
                                    BorderThickness="1.5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DeviceType, Converter={StaticResource DeviceTypeGlyph}}"
                                                   FontSize="19"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Alias}" FontWeight="SemiBold" FontSize="14"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock Text="🌐" FontSize="10" Opacity="0.7" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Ip}" Opacity="0.7" FontSize="11"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="·" Opacity="0.5" FontSize="11"/>
                                            <TextBlock Text="{Binding Port}" Opacity="0.7" FontSize="11"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding DeviceModel}" Opacity="0.5" FontSize="11"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4"
                                                VerticalAlignment="Top" Margin="0,2,0,0">
                                        <Ellipse Width="7" Height="7"
                                                 Fill="{Binding IsOnline, Converter={StaticResource BoolToOnlineDot}}"/>
                                        <TextBlock Text="{Binding IsOnline, Converter={StaticResource BoolToOnlineLabel}}"
                                                   FontSize="10" Opacity="0.7"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel x:ConnectionId='34' Grid.Row="2" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                     >
                    <TextBlock Text="📡" FontSize="40" HorizontalAlignment="Center"/>
                    <TextBlock Text="正在搜索附近设备..." FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="确保目标设备开启 LocalSend 并连接同一 Wi-Fi"
                               FontSize="12" Opacity="0.6" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" Margin="0,28,0,0" RowDefinitions="Auto,Auto,*,Auto">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="待发送文件" FontSize="16" FontWeight="SemiBold"/>
                        <Border Padding="8,2" CornerRadius="10" Background="{ThemeResource CardStrokeColorDefaultBrush}">
                            <TextBlock x:ConnectionId='31'                                                           FontSize="11" Opacity="0.7"/>
                        </Border>
                    </StackPanel>
                    <Button x:ConnectionId='29' Grid.Column="1" Content="📁 添加文件"                         
                            Padding="14,7" CornerRadius="8" Margin="0,0,8,0"/>
                    <Button x:ConnectionId='30' Grid.Column="2" Content="清空"                                               
                            Padding="10,7" CornerRadius="8"
                                                                                 />
                </Grid>

                <Border x:ConnectionId='5' Grid.Row="1" Margin="0,12,0,12" Padding="14,12" CornerRadius="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                                                                           >
                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="📤" FontSize="16" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,0" Spacing="2">
                            <TextBlock FontSize="12">
                                <Run Text="→"/>
                                <Run Text=" "/>
                                <Run x:ConnectionId='26'                                                            />
                                <Run Text="  ·  "/>
                                <Run x:ConnectionId='27'                                                              />
                                <Run Text=" / "/>
                                <Run x:ConnectionId='28'                                                           />
                                <Run Text=" 个文件"/>
                            </TextBlock>
                            <TextBlock x:ConnectionId='25' FontSize="11" Opacity="0.6"
                                                                                                                                 />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock FontSize="12" Opacity="0.75" VerticalAlignment="Center">
                                <Run x:ConnectionId='20'                                                                                      />
                                <Run Text=" / "/>
                                <Run x:ConnectionId='21'                                                                                  />
                                <Run Text="  ·  "/>
                                <Run x:ConnectionId='22'                                                                                                        />
                                <Run Text="%"/>
                                <Run x:ConnectionId='23'                                                                                                />
                                <Run x:ConnectionId='24'                                                                                     />
                            </TextBlock>
                            <Button x:ConnectionId='19' Content="取消"                                               
                                    Padding="10,4" CornerRadius="6" FontSize="12"/>
                        </StackPanel>
                        <ProgressBar x:ConnectionId='18' Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                                                                                                                         
                                     Minimum="0" Maximum="100" Margin="0,10,0,0" Height="6" CornerRadius="3"/>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Margin="0,12,0,0" Padding="12,0" CornerRadius="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        MaxHeight="320">
                    <Grid>
                        <ListView x:ConnectionId='14'                                               SelectionMode="None"
                                                                                       >
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,4,0,4"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,40,*,Auto,Auto,Auto">
                                        <Border Grid.Column="0" Width="4" CornerRadius="2" MaxHeight="32"
                                                VerticalAlignment="Center"
                                                Background="{Binding Status, Converter={StaticResource StatusColor}}"/>
                                        <Border Grid.Column="1" Width="40" Height="40" CornerRadius="10"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0">
                                            <TextBlock Text="{Binding FileKind, Converter={StaticResource FileKindGlyph}}"
                                                       FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Text="{Binding FileName}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ProgressBar Grid.Column="0" Margin="0,4,12,0" Height="4" CornerRadius="2"
                                                             Maximum="{Binding Size}"
                                                             Value="{Binding BytesSent, Mode=OneWay}"
                                                             Foreground="{Binding Status, Converter={StaticResource ProgressColor}}"
                                                             Visibility="{Binding Status, Converter={StaticResource ShowProgress}}"/>
                                                <TextBlock Grid.Column="1" FontSize="11" Opacity="0.6" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <Run Text="{Binding BytesSent, Mode=OneWay, Converter={StaticResource BytesToString}}"/>
                                                    <Run Text=" / "/>
                                                    <Run Text="{Binding Size, Mode=OneWay, Converter={StaticResource BytesToString}}"/>
                                                </TextBlock>
                                                <TextBlock Grid.Column="2" FontSize="11" Opacity="0.65"
                                                           Text="{Binding Status}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Text="{Binding ErrorMessage, Mode=OneWay}"
                                                   FontSize="11" Foreground="#D13438" Opacity="0.9"
                                                   VerticalAlignment="Center" Margin="0,0,10,0"
                                                   Visibility="{Binding Status, Converter={StaticResource FailedToVisible}}"/>
                                        <Button x:ConnectionId='17' Grid.Column="4" FontSize="12" Padding="8,4" CornerRadius="6"
                                                Content="移除"
                                                ToolTipService.ToolTip="从列表移除"
                                                                         
                                                Visibility="{Binding Status, Converter={StaticResource PendingOnlyToVisible}}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel x:ConnectionId='15' Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0,24"
                                                                                           >
                            <TextBlock Text="📄" FontSize="40" HorizontalAlignment="Center"/>
                            <TextBlock Text="还没有选择文件" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="点击上方“添加文件”选择要发送的文件" FontSize="12" Opacity="0.6" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="3" Margin="0,20,0,0" ColumnDefinitions="*,Auto">
                    <Grid Grid.Column="0" ColumnDefinitions="Auto,*">
                        <StackPanel Orientation="Vertical" Spacing="4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse x:ConnectionId='12' Width="10" Height="10"
                                                                                                                                             />
                                <TextBlock x:ConnectionId='13' FontSize="11" VerticalAlignment="Center"
                                                                                                                                                 />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse x:ConnectionId='10' Width="10" Height="10"
                                                                                                                                           />
                                <TextBlock x:ConnectionId='11' FontSize="11" VerticalAlignment="Center"
                                                                                                                                             />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse x:ConnectionId='8' Width="10" Height="10"
                                                                                                                                            />
                                <TextBlock x:ConnectionId='9' FontSize="11" VerticalAlignment="Center"
                                                                                                                                               />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock x:ConnectionId='7' Grid.Column="1"
                                   FontSize="12" Opacity="0.9" VerticalAlignment="Center"
                                   Margin="18,0,0,0"
                                                                                                                                   
                                                                                          />
                    </Grid>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button x:ConnectionId='6' Content="🚀 开始发送"
                                                                             
                                Padding="20,10" CornerRadius="10"
                                FontSize="14" FontWeight="SemiBold"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
</Page>

