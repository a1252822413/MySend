<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PcDemo.Views.SendPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    NavigationCacheMode="Enabled"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PcDemo.ViewModels"
    xmlns:c="using:PcDemo.Converters"
    xmlns:ctrls="using:PcDemo.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
    Background="Transparent"
    AllowDrop="True"
    DragOver="OnDragOver"
    DragLeave="OnDragLeave"
    Drop="OnDrop">
    <Page.Resources>
        <c:FileKindToGlyphConverter x:Key="FileKindGlyph"/>
        <c:FileKindToBrushConverter x:Key="FileKindBrush"/>
        <c:NullToCollapsed x:Key="NullToCollapsed"/>
        <c:BytesToString x:Key="BytesToString"/>
        <c:DoubleToPercent x:Key="DoubleToPercent"/>
        <c:DoubleToPercentText x:Key="DoubleToPercentText"/>
        <c:FailedToVisible x:Key="FailedToVisible"/>
        <c:PendingOnlyToVisible x:Key="PendingOnlyToVisible"/>
        <c:SendFileStatusToColor x:Key="StatusColor"/>
        <c:SendFileStatusToProgressColor x:Key="ProgressColor"/>
        <c:ShowProgressBarWhenInProgressOrDone x:Key="ShowProgress"/>
        <c:BoolToPassColor x:Key="BoolToPassColor"/>
        <c:BoolToHintColor x:Key="BoolToHintColor"/>
        <c:BoolToReadyTarget x:Key="BoolToReadyTarget"/>
        <c:BoolToReadyFile x:Key="BoolToReadyFile"/>
        <c:BoolToReadyState x:Key="BoolToReadyState"/>
        <c:BoolToOnlineDot x:Key="BoolToOnlineDot"/>
        <c:BoolToOnlineLabel x:Key="BoolToOnlineLabel"/>
        <c:DeviceTypeToGlyphConverter x:Key="DeviceTypeGlyph"/>
        <c:SendSessionStateToText x:Key="StateText"/>
        <c:BoolToSelectionBrush x:Key="PickBrush"/>
        <c:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
        <c:RefreshingTextConverter x:Key="RefreshingTextConverter"/>
        <c:BoolToVisibility x:Key="BoolToVisibility"/>

        <!-- 空态拖拽图标脉动：呼吸式明暗（code-behind 在 Loaded 时 Begin） -->
        <Storyboard x:Name="EmptyPulseStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="SendEmptyPulseIcon"
                             Storyboard.TargetProperty="Opacity"
                             From="0.3" To="1.0" Duration="0:0:1.4" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Page.Resources>

    <Grid Padding="{StaticResource SpacePage}" RowDefinitions="Auto,Auto,*" Background="Transparent"
          AllowDrop="True" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">
        <Border x:Name="DropHighlightBorder" Margin="{StaticResource SpaceZero}" CornerRadius="{StaticResource RadiusCard}"
                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                BorderThickness="2" Background="{ThemeResource AccentFillColorDefaultBrush}"
                Opacity="0" IsHitTestVisible="False"/>

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="{StaticResource GapMicro}">
                <TextBlock Text="发送文件" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="选择目标设备与文件，支持多选群发；非白名单设备在仅白名单模式下不可选" Style="{StaticResource PageSubtitleStyle}"/>
            </StackPanel>
        </Grid>

            <Grid Grid.Row="1" Margin="0,16,0,0" RowDefinitions="Auto,Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{StaticResource GapControl}" VerticalAlignment="Center">
                        <TextBlock Text="选择目标设备" FontSize="{StaticResource FontH2}" FontWeight="SemiBold"/>
                        <Border Padding="{StaticResource SpaceChip}" CornerRadius="{StaticResource RadiusRow}" Background="{ThemeResource CardStrokeColorDefaultBrush}">
                            <TextBlock Text="{x:Bind ViewModel.Devices.Count, Mode=OneWay}" FontSize="{StaticResource FontLabel}" Foreground="{ThemeResource BrandTextDimBrush}"/>
                        </Border>
                    </StackPanel>
                    <Button Grid.Column="1" Command="{x:Bind ViewModel.RefreshDevicesCommand}"
                            IsEnabled="{x:Bind ViewModel.IsRefreshing, Converter={StaticResource InvertedBoolConverter}}"
                            Padding="{StaticResource SpaceControl}" Background="Transparent" BorderThickness="0"
                            ToolTipService.ToolTip="重新搜索（每 20 秒自动刷新）">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControl}">
                            <ProgressRing Width="14" Height="14" IsActive="{x:Bind ViewModel.IsRefreshing}"/>
                            <TextBlock Text="{x:Bind ViewModel.IsRefreshing, Converter={StaticResource RefreshingTextConverter}}" FontSize="{StaticResource FontSm}"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- 已选目标：chips 行（每台一枚 chip，可单独移除，替代原来的摘要长条） -->
                <Border Grid.Row="1" Margin="0,12,0,0" Padding="{StaticResource SpaceRow}" CornerRadius="{StaticResource RadiusRow}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        Visibility="{x:Bind ViewModel.HasSelectedTarget, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Column="0" Text="发送到" FontSize="{StaticResource FontSm}" Foreground="{ThemeResource BrandTextDimBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto"
                                      HorizontalScrollMode="Auto"
                                      VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.SelectedTargets}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="{StaticResource GapControl}"/>
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,4,4,4" CornerRadius="{StaticResource RadiusCard}"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}">
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControl}">
                                                <TextBlock Text="{Binding DeviceType, Converter={StaticResource DeviceTypeGlyph}}"
                                                           FontFamily="Segoe Fluent Icons" FontSize="{StaticResource FontSm}"
                                                           VerticalAlignment="Center"
                                                           Foreground="{ThemeResource TextOnAccentFillColorDefaultBrush}"
                                                           AutomationProperties.AccessibilityView="Raw"/>
                                                <TextBlock Text="{Binding Alias}" FontSize="{StaticResource FontSm}" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" MaxWidth="150"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{ThemeResource TextOnAccentFillColorDefaultBrush}"/>
                                                <Button Width="20" Height="20" Padding="{StaticResource SpaceZero}" CornerRadius="{StaticResource RadiusRow}"
                                                        Background="Transparent" BorderThickness="0"
                                                        VerticalAlignment="Center"
                                                        Click="OnRemoveTargetChipClick"
                                                        AutomationProperties.Name="从已选目标移除该设备"
                                                        ToolTipService.ToolTip="从已选目标移除">
                                                    <FontIcon Glyph="&#xE711;" FontSize="{StaticResource FontLabel}"
                                                              Foreground="{ThemeResource TextOnAccentFillColorDefaultBrush}"/>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </ScrollViewer>
                        <Button Grid.Column="2" Content="清空" Padding="{StaticResource SpaceChip}" Margin="8,0,0,0" FontSize="{StaticResource FontSm}"
                                VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                                Click="OnDeselectTargetClick"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="2" x:Name="DeviceScroll" Margin="0,12,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{x:Bind ViewModel.HasDevices, Mode=OneWay}">
                    <!-- 官方网格布局：列间距(10)只存在于卡片之间，两侧零空隙，自动等宽铺满 -->
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Devices}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="300" MinItemHeight="100"
                                               MinColumnSpacing="10" MinRowSpacing="10"
                                               ItemsStretch="Fill"/>
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="{StaticResource SpaceCardCompact}" CornerRadius="{StaticResource RadiusCard}" Margin="{StaticResource SpaceZero}"
                                    Tapped="OnDeviceTileTapped"
                                    PointerEntered="OnDeviceTilePointerEntered"
                                    PointerExited="OnDeviceTilePointerExited"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{Binding IsPicked, Mode=OneWay, Converter={StaticResource PickBrush}}"
                                    BorderThickness="1.5"
                                    Opacity="{Binding CardOpacity}"
                                    AutomationProperties.Name="{Binding Alias}"
                                    AutomationProperties.HelpText="单击切换是否勾选该设备（可多选，群发给所有勾选设备）">
                                <!-- 入场：轻微上移淡入；hover 只改背景（边框绑定 IsPicked 不能覆盖） -->
                                <Border.Transitions>
                                    <TransitionCollection>
                                        <EntranceThemeTransition FromVerticalOffset="16"/>
                                    </TransitionCollection>
                                </Border.Transitions>
                                    <Border.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="加入白名单"
                                                            Click="OnAddToWhitelistClick"
                                                            DataContext="{Binding}"/>
                                            <MenuFlyoutItem Text="加入黑名单"
                                                            Click="OnAddToBlacklistClick"
                                                            DataContext="{Binding}"/>
                                        </MenuFlyout>
                                    </Border.ContextFlyout>
                                    <Grid ColumnDefinitions="3,Auto,*,Auto" VerticalAlignment="Center">
                                        <Border Grid.Column="0" Width="3" Height="44" CornerRadius="{StaticResource RadiusXs}"
                                                VerticalAlignment="Center" Margin="0,0,8,0"
                                                Background="{Binding IsOnline, Converter={StaticResource BoolToOnlineDot}}"/>
                                        <Border Grid.Column="1" Width="48" Height="48" CornerRadius="{StaticResource RadiusCard}"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                VerticalAlignment="Center">
                                            <!-- PUA 字形，必须显式指定 Segoe Fluent Icons 字体 -->
                                            <TextBlock Text="{Binding DeviceType, Converter={StaticResource DeviceTypeGlyph}}"
                                                       FontFamily="Segoe Fluent Icons"
                                                       FontSize="{StaticResource FontH1}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextOnAccentFillColorDefaultBrush}"/>
                                        </Border>
                                        <StackPanel Grid.Column="2" Margin="12,0,0,0" Spacing="{StaticResource GapMicro}" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControl}">
                                                <TextBlock Text="{Binding Alias}" FontWeight="SemiBold" FontSize="{StaticResource FontH2}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <!-- 白名单徽章：语义色主题资源（浅底深字） -->
                                                <Border Padding="{StaticResource SpaceChip}" CornerRadius="{StaticResource RadiusControl}"
                                                        Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                                        Visibility="{Binding IsWhitelisted, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="白名单" FontSize="{StaticResource FontLabel}"
                                                               Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                               AutomationProperties.AccessibilityView="Raw"/>
                                                </Border>
                                                <!-- 黑名单徽章 -->
                                                <Border Padding="{StaticResource SpaceChip}" CornerRadius="{StaticResource RadiusControl}"
                                                        Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                                        Visibility="{Binding IsBlacklisted, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="黑名单" FontSize="{StaticResource FontLabel}"
                                                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                               AutomationProperties.AccessibilityView="Raw"/>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapMicro}">
                                                <FontIcon Glyph="&#xE774;" FontSize="{StaticResource FontLabel}" Opacity="0.7"
                                                          VerticalAlignment="Center"
                                                          AutomationProperties.AccessibilityView="Raw"/>
                                                <TextBlock Text="{Binding Ip}" Foreground="{ThemeResource BrandTextDimBrush}" FontSize="{StaticResource FontLabel}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="·" Foreground="{ThemeResource BrandTextMuteBrush}" FontSize="{StaticResource FontLabel}"/>
                                                <TextBlock Text="{Binding Port}" Foreground="{ThemeResource BrandTextDimBrush}" FontSize="{StaticResource FontLabel}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding DeviceModel}" Foreground="{ThemeResource BrandTextMuteBrush}" FontSize="{StaticResource FontLabel}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="{StaticResource GapMicro}"
                                                    VerticalAlignment="Top" Margin="0,4,0,0">
                                            <Border Padding="{StaticResource SpaceChip}" CornerRadius="{StaticResource RadiusControl}"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    Visibility="{Binding IsPicked, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                                <FontIcon Glyph="&#xE73E;" FontSize="{StaticResource FontLabel}"
                                                          Foreground="{ThemeResource TextOnAccentFillColorDefaultBrush}"
                                                          AutomationProperties.AccessibilityView="Raw"/>
                                            </Border>
                                            <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                                     Fill="{Binding IsOnline, Converter={StaticResource BoolToOnlineDot}}"/>
                                            <TextBlock Text="{Binding IsOnline, Converter={StaticResource BoolToOnlineLabel}}"
                                                       FontSize="{StaticResource FontLabel}" Foreground="{ThemeResource BrandTextDimBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Margin="0,16,0,16" Spacing="{StaticResource GapControl}" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.HasNoDevices, Mode=OneWay}">
                    <FontIcon Glyph="&#xE721;" FontSize="{StaticResource IconGlyphLarge}" HorizontalAlignment="Center"/>
                    <TextBlock Text="正在搜索附近设备..." FontSize="{StaticResource FontH2}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="确保目标设备开启 LocalSend 并连接同一 Wi-Fi"
                               FontSize="{StaticResource FontSm}" Foreground="{ThemeResource BrandTextMuteBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" Margin="0,16,0,0" RowDefinitions="Auto,*,Auto">
                <!-- 操作行：窄窗口自动换行（FlowPanel），避免按钮被截断/盖住 -->
                <ctrls:FlowPanel Grid.Row="0" HorizontalSpacing="8" VerticalSpacing="8">
                    <StackPanel x:Name="ImportingIndicator" Orientation="Horizontal" Spacing="{StaticResource GapControl}"
                                VerticalAlignment="Center" Visibility="Collapsed">
                        <ProgressRing Width="14" Height="14" IsActive="True" VerticalAlignment="Center"
                                      AutomationProperties.Name="正在导入文件"/>
                        <TextBlock Text="导入中…" FontSize="{StaticResource FontSm}" Foreground="{ThemeResource BrandTextDimBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControl}" VerticalAlignment="Center">
                        <Button Click="OnPickFilesClick" Padding="12,0" Height="36" CornerRadius="{StaticResource RadiusControl}"
                                AutomationProperties.Name="添加文件">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControl}">
                                <FontIcon Glyph="&#xE8B7;" FontSize="{StaticResource FontH2}"/>
                                <TextBlock Text="添加文件"/>
                            </StackPanel>
                        </Button>
                        <Button Click="OnPickFolderClick" Padding="12,0" Height="36" CornerRadius="{StaticResource RadiusControl}"
                                AutomationProperties.Name="添加文件夹"
                                ToolTipService.ToolTip="选择文件夹（保留目录结构发送）">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControl}">
                                <FontIcon Glyph="&#xE8F4;" FontSize="{StaticResource FontH2}"/>
                                <TextBlock Text="添加文件夹"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Button Content="清空" Command="{x:Bind ViewModel.ClearFilesCommand}"
                            Padding="12,0" Height="36" CornerRadius="{StaticResource RadiusControl}"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.HasFiles, Mode=OneWay}"/>
                    <!-- PIN + 发送：窄时可随 FlowPanel 折行 -->
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControl}" VerticalAlignment="Center">
                        <Grid Width="110" VerticalAlignment="Center">
                            <PasswordBox x:Name="PinPasswordBox" PlaceholderText="PIN"
                                         Height="36" Padding="{StaticResource SpaceRow}" CornerRadius="{StaticResource RadiusControl}" FontSize="{StaticResource FontBody}"
                                         PasswordChanged="OnPinPasswordChanged"/>
                            <TextBox x:Name="PinVisibleBox" Visibility="Collapsed"
                                     Height="36" Padding="{StaticResource SpaceRow}" CornerRadius="{StaticResource RadiusControl}" FontSize="{StaticResource FontBody}"
                                     TextChanged="OnPinTextChanged"/>
                        </Grid>
                        <Button x:Name="PinToggleBtn" Width="40" Height="36" Padding="{StaticResource SpaceZero}"
                                Click="OnPinToggleClick" CornerRadius="{StaticResource RadiusControl}"
                                AutomationProperties.Name="显示或隐藏 PIN"
                                ToolTipService.ToolTip="显示/隐藏 PIN" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8D4;" FontSize="{StaticResource FontH2}"/>
                        </Button>
                    </StackPanel>
                    <!-- 「开始发送」已移到页面底部动作条（与「发送文字」并列），见本页最后一段 -->
                </ctrls:FlowPanel>

                <!-- 文件列表卡片：撑满工具条与底部动作条之间的空间（虚线拖放区随之成一大块），
                     同时把它与上下邻居的间距**做成一样小**，不随窗口高度变化。

                     踩过的三种状态，记录一下避免再绕：
                       1) MaxHeight="320" + 默认 Stretch → 被限高的元素在大槽位里居中，上下各一条死空白；
                       2) Stretch 但上下 margin 不等（12 / 16）+ 内边距 12 → 视觉上间距偏大且不对称；
                       3) VerticalAlignment="Top" → 卡片只贴内容，空白全堆到底部，上小下大。
                     现在：Stretch + 上下 margin 都是 8 + 内边距 12 → 上下各 20，等高且紧凑。 -->
                <Border Grid.Row="1" Margin="0,12,0,0" Padding="{StaticResource SpaceControl}" CornerRadius="{StaticResource RadiusCard}"
                        VerticalAlignment="Stretch"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid>
                        <ListView ItemsSource="{x:Bind ViewModel.PendingFiles}" SelectionMode="None"
                                  Visibility="{x:Bind ViewModel.HasFiles, Mode=OneWay}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,3,0,3"/>
                                    <Setter Property="MinHeight" Value="48"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="{StaticResource SpaceRow}" CornerRadius="{StaticResource RadiusRow}"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <Grid ColumnDefinitions="Auto,Auto,*" VerticalAlignment="Center">
                                            <Border Grid.Column="0" Width="4" CornerRadius="{StaticResource RadiusXs}" MaxHeight="32"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.AccessibilityView="Raw"
                                                    Background="{Binding Status, Converter={StaticResource StatusColor}}"/>
                                            <!-- 彩色文件图标：底色 = 类型色 14% 叠加，字形 = 类型色本身。
                                                 列宽必须是 Auto：原来写死 40 而图标框本身 40 + Margin 6 = 46，
                                                 溢出到内容列并把内容列的 10px 间距吃掉 6px，
                                                 实测图标框右沿到文字只剩 4px（左 8px 右 4px，很挤）。 -->
                                            <Border Grid.Column="1" Width="40" Height="40" CornerRadius="{StaticResource RadiusRow}"
                                                    Margin="8,0,0,0" VerticalAlignment="Center"
                                                    Background="{Binding FileKind, Converter={StaticResource FileKindBrush}}">
                                                <FontIcon Glyph="{Binding FileKind, Converter={StaticResource FileKindGlyph}}"
                                                          FontSize="{StaticResource FontH1}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          AutomationProperties.AccessibilityView="Raw"
                                                          Foreground="{Binding FileKind, Converter={StaticResource FileKindBrush}, ConverterParameter=glyph}"/>
                                            </Border>
                                            <Grid Grid.Column="2" Margin="12,0,0,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding FileName}"
                                                               FontSize="{StaticResource FontBody}" FontWeight="SemiBold"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="1" FontSize="{StaticResource FontLabel}" Foreground="{ThemeResource BrandTextMuteBrush}" VerticalAlignment="Center">
                                                        <Run Text="{Binding BytesSent, Mode=OneWay, Converter={StaticResource BytesToString}}"/>
                                                        <Run Text=" / "/>
                                                        <Run Text="{Binding Size, Mode=OneWay, Converter={StaticResource BytesToString}}"/>
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="2" FontSize="{StaticResource FontLabel}" Foreground="{ThemeResource BrandTextDimBrush}"
                                                               Text="{Binding Status}" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="3" FontSize="{StaticResource FontSm}" Padding="{StaticResource SpaceChip}" CornerRadius="{StaticResource RadiusControl}"
                                                            Content="移除" VerticalAlignment="Center" Margin="0,0,8,0"
                                                            ToolTipService.ToolTip="从列表移除"
                                                            Click="OnRemoveFileClick"
                                                            Visibility="{Binding Status, Converter={StaticResource PendingOnlyToVisible}}"/>
                                                </Grid>
                                                <ProgressBar Grid.Row="1" Margin="0,4,0,0" Height="4" CornerRadius="{StaticResource RadiusXs}"
                                                             AutomationProperties.Name="{Binding FileName}"
                                                             Maximum="{Binding Size}"
                                                             Value="{Binding BytesSent, Mode=OneWay}"
                                                             Foreground="{Binding Status, Converter={StaticResource ProgressColor}}"
                                                             Visibility="{Binding Status, Converter={StaticResource ShowProgress}}"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <!-- 无文件：虚线拖拽大区（视觉重心从"按钮堆"变成"区域"），内嵌剪贴板一键添加提示 -->
                        <Grid MinHeight="200" Visibility="{x:Bind ViewModel.HasNoFiles, Mode=OneWay}">
                            <Rectangle Stroke="{ThemeResource CardStrokeColorDefaultBrush}" StrokeThickness="1.5"
                                       StrokeDashArray="4 3" RadiusX="10" RadiusY="10"
                                       Fill="Transparent" Margin="{StaticResource SpaceMicro}" IsHitTestVisible="False"/>
                            <StackPanel Spacing="{StaticResource GapControl}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="{StaticResource SpacePage}">
                                <FontIcon x:Name="SendEmptyPulseIcon" Glyph="&#xE898;" FontSize="{StaticResource IconGlyphLarge}"
                                          HorizontalAlignment="Center"
                                          Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                          AutomationProperties.AccessibilityView="Raw"/>
                                <TextBlock Text="拖放文件或文件夹到此处" FontSize="{StaticResource FontH2}" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                <TextBlock Text="也可以点击上方「添加文件 / 添加文件夹」，或按 Ctrl+V 粘贴"
                                           FontSize="{StaticResource FontSm}" Foreground="{ThemeResource BrandTextMuteBrush}" HorizontalAlignment="Center"/>
                                <!-- 剪贴板有文件 → 一键添加提示（读取失败/无文件时整行隐藏） -->
                                <Button Click="OnAddClipboardClick" Margin="0,8,0,0" Padding="12,4" CornerRadius="{StaticResource RadiusCard}"
                                        Background="{ThemeResource ChipFillBrush}"
                                        BorderThickness="0" HorizontalAlignment="Center"
                                        Visibility="{x:Bind ViewModel.HasClipboardFiles, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControl}">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="{StaticResource FontBody}"/>
                                        <TextBlock Text="{x:Bind ViewModel.ClipboardHintText, Mode=OneWay}" FontSize="{StaticResource FontSm}"/>
                                        <TextBlock Text="· 点此添加" FontSize="{StaticResource FontSm}" Foreground="{ThemeResource BrandTextDimBrush}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 底部动作条：左侧就绪状态（三条件），右侧主/次操作。
                     发送中的实时进度由"发送进度对话框"承担（它是模态、覆盖整页），
                     底部再放一条进度条永远会被挡住，所以这里不重复放。 -->
                <!-- 与列表卡片的间距（8）保持一致，上下等距 -->
                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Border Padding="16,12" CornerRadius="{StaticResource RadiusCard}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource GapSection}">
                            <Grid Grid.Column="0" ColumnDefinitions="*,*,*" ColumnSpacing="{StaticResource GapBlock}">
                            <Grid Grid.Column="0" ColumnDefinitions="Auto,*">
                                <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center"
                                         Fill="{x:Bind ViewModel.HasSelectedTarget, Mode=OneWay, Converter={StaticResource BoolToPassColor}}"/>
                                <TextBlock Grid.Column="1" Margin="8,0,0,0" FontSize="{StaticResource FontSm}" VerticalAlignment="Center"
                                           Text="{x:Bind ViewModel.HasSelectedTarget, Mode=OneWay, Converter={StaticResource BoolToReadyTarget}}"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                            <Grid Grid.Column="1" ColumnDefinitions="Auto,*">
                                <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center"
                                         Fill="{x:Bind ViewModel.HasPendingFiles, Mode=OneWay, Converter={StaticResource BoolToPassColor}}"/>
                                <TextBlock Grid.Column="1" Margin="8,0,0,0" FontSize="{StaticResource FontSm}" VerticalAlignment="Center"
                                           Text="{x:Bind ViewModel.HasPendingFiles, Mode=OneWay, Converter={StaticResource BoolToReadyFile}}"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                            <Grid Grid.Column="2" ColumnDefinitions="Auto,*">
                                <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center"
                                         Fill="{x:Bind ViewModel.IsIdleOrFinished, Mode=OneWay, Converter={StaticResource BoolToPassColor}}"/>
                                <TextBlock Grid.Column="1" Margin="8,0,0,0" FontSize="{StaticResource FontSm}" VerticalAlignment="Center"
                                           Text="{x:Bind ViewModel.IsIdleOrFinished, Mode=OneWay, Converter={StaticResource BoolToReadyState}}"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                            </Grid>

                            <!-- 主/次操作：从文件区顶部动作行移下来，成为真正的底部动作条 -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource GapControl}" VerticalAlignment="Center">
                                <Button Click="OnSendTextClick" Padding="12,0" Height="36" CornerRadius="{StaticResource RadiusControl}"
                                        AutomationProperties.Name="发送文字"
                                        ToolTipService.ToolTip="发送文字/剪贴板内容（对方保存为 .txt）">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControl}">
                                        <FontIcon Glyph="&#xE70F;" FontSize="{StaticResource FontH2}"/>
                                        <TextBlock Text="发送文字"/>
                                    </StackPanel>
                                </Button>
                                <Button Content="开始发送"
                                        Command="{x:Bind ViewModel.StartSendCommand}"
                                        AutomationProperties.Name="开始发送"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.SendDisabledHint, Mode=OneWay}"
                                        Padding="24,0" Height="36" CornerRadius="{StaticResource RadiusRow}"
                                        FontSize="{StaticResource FontH2}" FontWeight="SemiBold" VerticalAlignment="Center"
                                        Background="{ThemeResource BrandAccentFillBrush}"
                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}">
                                    <Button.ContentTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControl}" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE724;" FontSize="{StaticResource FontH2}"
                                                          Foreground="{ThemeResource TextOnAccentFillColorDefaultBrush}"
                                                          AutomationProperties.AccessibilityView="Raw"/>
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </Button.ContentTemplate>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
</Page>
