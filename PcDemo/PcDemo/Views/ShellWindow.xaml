<?xml version="1.0" encoding="utf-8"?>
<!--
  主窗口：自定义标题栏 + NavigationView（接收/发送/设备管理/历史 + 底部设置）+ Frame 内容区。
  视觉值全部来自 Styles/DesignTokens.xaml；窗口材质由系统 Mica 提供，应用内无材质设置项。
  顶部悬浮提醒由 code-behind 的 TopToast.AttachTo(RootGrid) 挂在内容区右上角。
-->
<Window
    x:Class="PcDemo.Views.ShellWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="快传">

    <Grid x:Name="RootGrid" RowDefinitions="32,*">
        <!-- 自定义标题栏：汉堡按钮 + 应用图标 + 名称 -->
        <Grid x:Name="AppTitleBar" Grid.Row="0"
              Background="Transparent"
              Padding="4,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="PaneToggleButton" Grid.Column="0"
                    Click="OnPaneToggleClick"
                    AutomationProperties.Name="收起或展开侧边栏"
                    ToolTipService.ToolTip="收起/展开侧边栏"
                    Background="Transparent" BorderThickness="0"
                    Width="32" Height="32" Padding="0">
                <Viewbox Width="16" Height="16">
                    <SymbolIcon Symbol="GlobalNavigationButton"/>
                </Viewbox>
            </Button>
            <Image Grid.Column="1" Source="Assets/Square44x44Logo.targetsize-24_altform-unplated.png"
                   AutomationProperties.Name="快传"
                   Width="16" Height="16" Margin="4,0,0,0" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="快传" FontSize="{StaticResource FontSm}" FontWeight="SemiBold"
                       Margin="8,0,0,0" VerticalAlignment="Center"
                       Foreground="{ThemeResource BrandTextBrush}"/>
        </Grid>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            PaneDisplayMode="Left"
            OpenPaneLength="168"
            CompactPaneLength="48"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            SelectionChanged="OnSelectionChanged">
            <NavigationView.Resources>
                <!-- 侧边栏底色：与标题栏形成一条通到底的色带。
                     键名必须是 NavigationViewDefaultPaneBackground（generic.xaml 真正消费的键）；
                     NavigationViewPaneBackground 是死资源，写了不会生效也不报错。 -->
                <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground"
                                 Color="{ThemeResource LayerFillColorDefault}"
                                 Opacity="1.0"/>
            </NavigationView.Resources>

            <NavigationView.MenuItems>
                <NavigationViewItem Tag="Receive" Icon="Download" Content="接收"/>
                <NavigationViewItem Tag="Send" Icon="Send" Content="发送"/>
                <NavigationViewItem Tag="History" Icon="Clock" Content="历史记录"/>
                <NavigationViewItem Tag="DeviceList" Icon="People" Content="设备管理"/>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Tag="Settings" Icon="Setting" Content="设置"/>
            </NavigationView.FooterMenuItems>

            <!-- 常驻服务状态：关窗隐藏到托盘后仍在接收（设计稿 nav-foot）。
                 注意：PaneFooter 已位于 FooterMenuItems(设置) 之下、紧贴窗底；
                 内层 StackPanel 绝不能设 VerticalAlignment=Bottom，否则会被窗口底边裁切/与设置项挤叠。 -->
            <NavigationView.PaneFooter>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControl}"
                            Margin="16,4,16,12">
                    <Border Width="24" Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}"
                            VerticalAlignment="Center" Margin="0,0,0,0"/>
                    <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                             Fill="{ThemeResource BrandAccentInkBrush}"/>
                    <TextBlock Text="后台接收中" FontSize="{StaticResource FontLabel}"
                               Foreground="{ThemeResource BrandTextDimBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </NavigationView.PaneFooter>

            <!-- 内容区保持透明，让系统 Mica 壁纸透出；卡片本身不透明 ≥0.90 以保对比度 -->
            <Frame x:Name="ContentFrame"
                   Background="{ThemeResource LayerOnMicaBaseAltFillColorTransparentBrush}">
                <Frame.ContentTransitions>
                    <TransitionCollection>
                        <NavigationThemeTransition>
                            <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                                <SlideNavigationTransitionInfo Effect="FromRight"/>
                            </NavigationThemeTransition.DefaultNavigationTransitionInfo>
                        </NavigationThemeTransition>
                    </TransitionCollection>
                </Frame.ContentTransitions>
            </Frame>
        </NavigationView>
    </Grid>
</Window>
