<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PcDemo.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:PcDemo.Models"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <!-- 空态图标脉动：与接收页同一节奏（呼吸式明暗），保持全应用一致 -->
        <Storyboard x:Name="EmptyPulseStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="EmptyPulseIcon"
                             Storyboard.TargetProperty="Opacity"
                             From="0.3" To="1.0" Duration="0:0:1.4" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Page.Resources>

    <Grid RowDefinitions="Auto,Auto,*" Padding="{StaticResource SpacePage}">
        <!-- ① 标题行 -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
            <StackPanel Grid.Column="0" Spacing="{StaticResource GapMicro}" VerticalAlignment="Center">
                <TextBlock Text="历史记录" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="最近 50 条传输记录，点击可查看逐文件明细" Style="{StaticResource PageSubtitleStyle}"/>
            </StackPanel>
            <Button Grid.Column="2" Click="OnClearClick" Padding="{StaticResource SpaceRow}" CornerRadius="{StaticResource RadiusControl}"
                    Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay}"
                    ToolTipService.ToolTip="清空全部传输记录（需二次确认）">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControl}">
                    <FontIcon Glyph="&#xE74D;" FontSize="{StaticResource FontBody}" VerticalAlignment="Center"
                              AutomationProperties.AccessibilityView="Raw"/>
                    <TextBlock Text="清空记录" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ② 筛选栏：分段控件（方向）+ 搜索框 -->
        <Grid Grid.Row="1" Margin="0,12,0,0" ColumnDefinitions="Auto,*,Auto">
            <Border Grid.Column="0" Padding="{StaticResource SpaceMicro}" CornerRadius="{StaticResource RadiusRow}" VerticalAlignment="Center"
                    Background="{ThemeResource ChipFillBrush}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapMicro}">
                    <Button Click="OnFilterAllClick" Content="全部" x:Name="FilterAllBtn"
                            Padding="12,4" CornerRadius="{StaticResource RadiusControl}" BorderThickness="0"/>
                    <Button Click="OnFilterSendClick" Content="发送" x:Name="FilterSendBtn"
                            Padding="12,4" CornerRadius="{StaticResource RadiusControl}" BorderThickness="0"/>
                    <Button Click="OnFilterReceiveClick" Content="接收" x:Name="FilterReceiveBtn"
                            Padding="12,4" CornerRadius="{StaticResource RadiusControl}" BorderThickness="0"/>
                </StackPanel>
            </Border>
            <TextBox Grid.Column="2" x:Name="SearchBox" Width="240" PlaceholderText="搜索设备名 / 文件名"
                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     CornerRadius="{StaticResource RadiusControl}" Padding="{StaticResource SpaceRow}"/>
        </Grid>

        <ListView Grid.Row="2" Margin="0,12,0,0" ItemsSource="{x:Bind ViewModel.FilteredItems, Mode=OneWay}" SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="MinHeight" Value="0"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="m:TransferHistoryItem">
                    <Border Margin="0,0,0,8" Padding="{StaticResource SpaceCardCompact}" CornerRadius="{StaticResource RadiusCard}"
                            PointerEntered="OnItemPointerEntered"
                            PointerExited="OnItemPointerExited"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Border.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="查看文件明细" Click="OnShowDetailsClick"
                                                DataContext="{Binding}"/>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem Text="复制保存路径" Click="OnCopyPathClick"
                                                DataContext="{Binding}"/>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem Text="删除这条记录" Click="OnDeleteHistoryClick"
                                                DataContext="{Binding}"/>
                            </MenuFlyout>
                        </Border.ContextFlyout>
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="{StaticResource GapBlock}" VerticalAlignment="Center">
                            <!-- 方向图标瓦片（品牌绿圆底 + 单色字形） -->
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="{StaticResource RadiusCard}" VerticalAlignment="Center"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}">
                                <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="{StaticResource FontH2}"
                                          Foreground="{ThemeResource TextOnAccentFillColorDefaultBrush}"
                                          AutomationProperties.AccessibilityView="Raw"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{StaticResource GapMicro}">
                                <TextBlock Text="{x:Bind PeerText}" FontSize="{StaticResource FontH2}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock FontSize="{StaticResource FontSm}" Foreground="{ThemeResource BrandTextDimBrush}" TextTrimming="CharacterEllipsis">
                                    <Run Text="{x:Bind FilesText}"/><Run Text=" · "/><Run Text="{x:Bind SizeText}"/>
                                    <Run Text=" · "/><Run Text="{x:Bind FirstFileName}"/>
                                </TextBlock>
                            </StackPanel>
                            <!-- 状态 chip：浅底深字（系统语义色），深浅主题自适应 -->
                            <Border Grid.Column="2" Padding="{StaticResource SpaceChip}" CornerRadius="{StaticResource RadiusControl}" VerticalAlignment="Center"
                                    Background="{x:Bind StatusBackgroundBrush}">
                                <TextBlock Text="{x:Bind StatusText}" FontSize="{StaticResource FontLabel}"
                                           Foreground="{x:Bind StatusForegroundBrush}"/>
                            </Border>
                            <TextBlock Grid.Column="3" Text="{x:Bind TimeText}" FontSize="{StaticResource FontSm}" Foreground="{ThemeResource BrandTextMuteBrush}" VerticalAlignment="Center"/>
                            <Button Grid.Column="4" Click="OnOpenFolderClick"
                                    Padding="{StaticResource SpaceChip}" CornerRadius="{StaticResource RadiusControl}" FontSize="{StaticResource FontSm}"
                                    VerticalAlignment="Center"
                                    Visibility="{x:Bind OpenFolderVisibility}"
                                    ToolTipService.ToolTip="在资源管理器中打开保存位置">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapMicro}">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="{StaticResource FontSm}" VerticalAlignment="Center"
                                              AutomationProperties.AccessibilityView="Raw"/>
                                    <TextBlock Text="打开位置" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- ③ 空态：图标 + 文案（脉动） -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="{StaticResource GapControl}"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
            <FontIcon x:Name="EmptyPulseIcon" Glyph="&#xE81C;" FontSize="{StaticResource IconGlyphLarge}"
                      Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                      AutomationProperties.AccessibilityView="Raw"/>
            <TextBlock Text="暂无传输记录" FontSize="{StaticResource FontH2}" FontWeight="SemiBold" Foreground="{ThemeResource BrandTextDimBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="收发文件完成后会自动记录在这里" FontSize="{StaticResource FontSm}" Foreground="{ThemeResource BrandTextMuteBrush}" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Page>
