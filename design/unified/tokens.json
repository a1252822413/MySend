{
  "version": "1.3.0",
  "name": "快传统一设计令牌",
  "source": "design/unified/tokens.css",
  "authority": [
    "docs/harmonyos-app-design.md §6 (226-242)",
    "docs/UI-SPACING.md (8-34)"
  ],
  "platforms": {
    "css": "design/unified/tokens.css",
    "xaml": "design/unified/handoff/DesignTokens.xaml",
    "arkts": "design/unified/handoff/Theme.ets"
  },
  "tokens": [
    {
      "name": "bg",
      "role": "页面底",
      "css": "--bg",
      "xaml": "BrandBgBrush",
      "arkts": "bg",
      "light": "#F0F3F1",
      "dark": "#0A0E0C"
    },
    {
      "name": "bgVoid",
      "role": "最外层/评审板底",
      "css": "--bg-void",
      "xaml": "BrandBgVoidBrush",
      "arkts": "bgVoid",
      "light": "#EAEEEC",
      "dark": "#070A09"
    },
    {
      "name": "surface",
      "role": "一级卡片（不透明档）",
      "css": "--surface",
      "xaml": "BrandSurfaceBrush",
      "arkts": "surface",
      "light": "#FFFFFF",
      "dark": "#151F1B"
    },
    {
      "name": "surface2",
      "role": "卡内嵌块/输入/轨道",
      "css": "--surface-2",
      "xaml": "BrandSurface2Brush",
      "arkts": "surface2",
      "light": "#F1F5F3",
      "dark": "#1B2622"
    },
    {
      "name": "surface3",
      "role": "按下态/开关槽",
      "css": "--surface-3",
      "xaml": "BrandSurface3Brush",
      "arkts": "surface3",
      "light": "#E3EAE7",
      "dark": "#24302B"
    },
    {
      "name": "surfaceHi",
      "role": "悬停态",
      "css": "--surface-hi",
      "xaml": "BrandSurfaceHiBrush",
      "arkts": "surfaceHi",
      "light": "#FBFDFC",
      "dark": "#1D2823"
    },
    {
      "name": "text",
      "role": "主文字",
      "css": "--text",
      "xaml": "BrandTextBrush",
      "arkts": "text",
      "light": "#0F1614",
      "dark": "#E9F1EE"
    },
    {
      "name": "textDim",
      "role": "次要文字",
      "css": "--text-dim",
      "xaml": "BrandTextDimBrush",
      "arkts": "textDim",
      "light": "#55635C",
      "dark": "#9AA8A3"
    },
    {
      "name": "textMute",
      "role": "微型标签",
      "css": "--text-mute",
      "xaml": "BrandTextMuteBrush",
      "arkts": "textMute",
      "light": "#6B7A72",
      "dark": "#7B8A84"
    },
    {
      "name": "accent",
      "role": "品牌绿/图形/进度/选中",
      "css": "--accent",
      "xaml": "BrandAccentBrush",
      "arkts": "accent",
      "light": "#16A34A",
      "dark": "#3BE49A"
    },
    {
      "name": "accentFill",
      "role": "实心按钮底（白/深字达 AA）",
      "css": "--accent-fill",
      "xaml": "BrandAccentFillBrush",
      "arkts": "accentFill",
      "light": "#15803D",
      "dark": "#3BE49A"
    },
    {
      "name": "accentInk",
      "role": "绿色小字",
      "css": "--accent-ink",
      "xaml": "BrandAccentInkBrush",
      "arkts": "accentInk",
      "light": "#0F7A3C",
      "dark": "#3BE49A"
    },
    {
      "name": "onAccent",
      "role": "强调底上的文字",
      "css": "--on-accent",
      "xaml": "BrandOnAccentBrush",
      "arkts": "onAccent",
      "light": "#FFFFFF",
      "dark": "#04110B"
    },
    {
      "name": "accentSoft",
      "role": "强调弱底/chip",
      "css": "--accent-soft",
      "xaml": "BrandAccentSoftBrush",
      "arkts": "accentSoft",
      "light": "rgba(22,163,74,0.10)",
      "dark": "rgba(59,228,154,0.13)"
    },
    {
      "name": "line",
      "role": "卡内分隔线",
      "css": "--line",
      "xaml": "BrandLineBrush",
      "arkts": "line",
      "light": "rgba(16,22,19,0.07)",
      "dark": "rgba(233,241,238,0.07)"
    },
    {
      "name": "lineStrong",
      "role": "强分隔",
      "css": "--line-strong",
      "xaml": "BrandLineStrongBrush",
      "arkts": "lineStrong",
      "light": "rgba(16,22,19,0.13)",
      "dark": "rgba(233,241,238,0.13)"
    },
    {
      "name": "cardBorder",
      "role": "卡片描边",
      "css": "--card-border",
      "xaml": "BrandCardBorderBrush",
      "arkts": "cardBorder",
      "light": "rgba(16,22,19,0.10)",
      "dark": "rgba(233,241,238,0.10)"
    },
    {
      "name": "materialWindow",
      "role": "窗口/页面底材质（云母档）",
      "css": "--material-window",
      "xaml": "MaterialWindowBrush",
      "arkts": "materialWindow",
      "light": "rgba(246,249,247,0.74)",
      "dark": "rgba(10,14,12,0.72)"
    },
    {
      "name": "materialPanel",
      "role": "导航/标题栏/底栏材质",
      "css": "--material-panel",
      "xaml": "MaterialPanelBrush",
      "arkts": "materialPanel",
      "light": "rgba(248,251,249,0.62)",
      "dark": "rgba(21,31,27,0.58)"
    },
    {
      "name": "materialCard",
      "role": "卡片材质（≥0.90 保对比度）",
      "css": "--material-card",
      "xaml": "MaterialCardBrush",
      "arkts": "materialCard",
      "light": "rgba(255,255,255,0.90)",
      "dark": "rgba(21,31,27,0.90)"
    },
    {
      "name": "blurWindow",
      "role": "窗口模糊半径 px（云母档）",
      "css": "--blur-window",
      "xaml": "MaterialBlurWindow",
      "arkts": "blurWindow",
      "light": 48,
      "dark": 48
    },
    {
      "name": "blurCard",
      "role": "卡片模糊半径 px",
      "css": "--blur-card",
      "xaml": "MaterialBlurCard",
      "arkts": "blurCard",
      "light": 12,
      "dark": 12
    },
    {
      "name": "success",
      "role": "在线/成功",
      "css": "--success",
      "xaml": "BrandSuccessBrush",
      "arkts": "success",
      "light": "#15803D",
      "dark": "#3BE49A"
    },
    {
      "name": "warning",
      "role": "警告/离开",
      "css": "--warning",
      "xaml": "BrandWarningBrush",
      "arkts": "warn",
      "light": "#B06F00",
      "dark": "#FFB64D"
    },
    {
      "name": "danger",
      "role": "失败/拒绝",
      "css": "--danger",
      "xaml": "BrandDangerBrush",
      "arkts": "danger",
      "light": "#C0392B",
      "dark": "#FF6B5A"
    },
    {
      "name": "dangerSoft",
      "role": "失败提醒图标底",
      "css": "--danger-soft",
      "xaml": "BrandDangerSoftBrush",
      "arkts": "dangerSoft",
      "light": "rgba(192,57,43,0.10)",
      "dark": "rgba(255,107,90,0.14)"
    },
    {
      "name": "scrim",
      "role": "模态遮罩",
      "css": "--scrim",
      "xaml": "BrandScrimBrush",
      "arkts": "scrim",
      "light": "rgba(15,22,19,0.30)",
      "dark": "rgba(4,7,6,0.62)"
    }
  ],
  "scale": {
    "space": {
      "0": 0,
      "1": 4,
      "2": 8,
      "3": 12,
      "4": 16,
      "5": 24,
      "6": 32,
      "7": 48,
      "allowed": [
        0,
        4,
        8,
        12,
        16,
        24,
        32
      ]
    },
    "semantic": {
      "page": 24,
      "section": 16,
      "block": 12,
      "card": 16,
      "cardCompact": 12,
      "control": 8,
      "micro": 4
    },
    "radius": {
      "xs": 4,
      "control": 8,
      "row": 10,
      "card": 12,
      "window": 8,
      "pill": 999
    },
    "font": {
      "display": 30,
      "h1": 22,
      "h2": 15,
      "body": 13,
      "sm": 12,
      "label": 11
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    },
    "size": {
      "controlH": 36,
      "touchMin": 44,
      "iconBlock": 40,
      "avatar": 56
    },
    "motion": {
      "fast": 160,
      "base": 300,
      "ease": "cubic-bezier(0.16,1,0.3,1)"
    }
  },
  "material": {
    "note": "系统材质适配，双端同一语义；由系统与省电/高对比度/减少透明状态驱动，产品内不提供设置项；卡片透明度 ≥0.90，保证文字对比度不被壁纸拉低",
    "levels": [
      {
        "id": "mica",
        "pc": "MicaBackdrop（Windows 11）",
        "harmony": "backgroundBlurStyle(BlurStyle.COMPONENT_THICK)",
        "blurWindow": 48,
        "windowAlpha": 0.74
      },
      {
        "id": "acrylic",
        "pc": "DesktopAcrylicBackdrop（Win10 1809+）",
        "harmony": "backgroundBlurStyle(BlurStyle.COMPONENT_REGULAR)",
        "blurWindow": 24,
        "windowAlpha": 0.88
      },
      {
        "id": "solid",
        "pc": "纯色 SolidColorBrush",
        "harmony": "不设模糊",
        "blurWindow": 0,
        "windowAlpha": 1.0
      }
    ],
    "degrade": "系统开启「减少透明/高对比度」或设备进入省电模式时自动退回 solid"
  },
  "shadow": {
    "note": "v1.1 减重：层级靠 1px 描边 + 近距投影表达，不再使用大范围高透明度投影",
    "light": {
      "card": "0 1px 1px rgba(16,22,19,0.02), 0 1px 2px rgba(16,22,19,0.025)",
      "cardHover": "0 1px 2px rgba(16,22,19,0.025), 0 3px 8px rgba(16,22,19,0.045)",
      "window": "0 1px 2px rgba(16,22,19,0.04), 0 6px 18px rgba(16,22,19,0.06)",
      "dialog": "0 2px 6px rgba(16,22,19,0.05), 0 12px 32px rgba(16,22,19,0.10)"
    },
    "dark": {
      "card": "0 1px 0 rgba(255,255,255,0.02) inset, 0 1px 2px rgba(0,0,0,0.16)",
      "cardHover": "0 1px 0 rgba(255,255,255,0.03) inset, 0 3px 8px rgba(0,0,0,0.20)",
      "window": "0 1px 2px rgba(0,0,0,0.22), 0 8px 22px rgba(0,0,0,0.24)",
      "dialog": "0 2px 8px rgba(0,0,0,0.26), 0 16px 40px rgba(0,0,0,0.32)"
    }
  },
  "dialogs": [
    {
      "id": "receive-request",
      "pc": "ContentDialog",
      "harmony": "bindSheet 半模态",
      "size": "L"
    },
    {
      "id": "pin",
      "pc": "ContentDialog",
      "harmony": "AlertDialog",
      "size": "S"
    },
    {
      "id": "send-progress",
      "pc": "ContentDialog（可后台）",
      "harmony": "bindSheet 半模态",
      "size": "L"
    },
    {
      "id": "receive-progress",
      "pc": "ContentDialog（可后台）",
      "harmony": "bindSheet 半模态",
      "size": "L"
    },
    {
      "id": "text",
      "pc": "ContentDialog",
      "harmony": "bindSheet 半模态",
      "size": "L"
    },
    {
      "id": "detail",
      "pc": "ContentDialog",
      "harmony": "bindSheet 半模态",
      "size": "L"
    },
    {
      "id": "rename",
      "pc": "ContentDialog",
      "harmony": "AlertDialog",
      "size": "S"
    },
    {
      "id": "clear",
      "pc": "ContentDialog（危险操作）",
      "harmony": "AlertDialog（危险操作）",
      "size": "S"
    }
  ],
  "wcag": {
    "target": "WCAG 2.1 AA",
    "checks": [
      {
        "pair": "text / surface",
        "light": "18.34:1",
        "dark": "14.70:1",
        "pass": true
      },
      {
        "pair": "textDim / surface",
        "light": "6.31:1",
        "dark": "6.84:1",
        "pass": true
      },
      {
        "pair": "textMute / surface",
        "light": "4.51:1",
        "dark": "4.67:1",
        "pass": true
      },
      {
        "pair": "onAccent / accentFill",
        "light": "5.02:1",
        "dark": "11.70:1",
        "pass": true
      },
      {
        "pair": "accentInk / surface",
        "light": "5.43:1",
        "dark": "10.25:1",
        "pass": true
      },
      {
        "pair": "accent / surface（卡片内图形）",
        "light": "3.30:1",
        "dark": "10.25:1",
        "pass": true
      },
      {
        "pair": "accentInk / bg（页面底）",
        "light": "4.86:1",
        "dark": "11.79:1",
        "pass": true
      },
      {
        "pair": "accent / bg（禁止直接使用）",
        "light": "2.95:1",
        "dark": "11.79:1",
        "pass": false,
        "note": "亮色页面底上不足 3:1，绿色文字/图形一律改用 accentInk"
      },
      {
        "pair": "品牌原色 #16A34A + 白字（已弃用）",
        "light": "3.30:1",
        "dark": "3.30:1",
        "pass": false,
        "note": "故实心按钮改用 accentFill #15803D"
      }
    ]
  }
}
