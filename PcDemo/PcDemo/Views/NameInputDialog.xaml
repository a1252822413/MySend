<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="PcDemo.Views.NameInputDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="重命名"
    PrimaryButtonText="保存"
    CloseButtonText="取消"
    DefaultButton="Primary">

    <StackPanel Width="360" Spacing="{StaticResource GapControl}">
        <TextBlock Text="输入新的显示名称（仅本地生效，不影响对方设备上的名字）。"
                   FontSize="{StaticResource FontSm}" Foreground="{ThemeResource BrandTextDimBrush}" TextWrapping="Wrap"/>
        <TextBox x:Name="InputBox" PlaceholderText="输入名称" MaxLength="60" FontSize="{StaticResource FontH2}"/>
    </StackPanel>
</ContentDialog>
