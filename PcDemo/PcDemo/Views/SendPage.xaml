<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PcDemo.Views.SendPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    NavigationCacheMode="Enabled"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PcDemo.ViewModels"
    xmlns:c="using:PcDemo.Converters"
    xmlns:ctrls="using:PcDemo.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
    Background="Transparent"
    AllowDrop="True"
    DragOver="OnDragOver"
    DragLeave="OnDragLeave"
    Drop="OnDrop">
    <Page.Resources>
        <c:FileKindToGlyphConverter x:Key="FileKindGlyph"/>
        <c:NullToCollapsed x:Key="NullToCollapsed"/>
        <c:BytesToString x:Key="BytesToString"/>
        <c:DoubleToPercent x:Key="DoubleToPercent"/>
        <c:DoubleToPercentText x:Key="DoubleToPercentText"/>
        <c:FailedToVisible x:Key="FailedToVisible"/>
        <c:PendingOnlyToVisible x:Key="PendingOnlyToVisible"/>
        <c:SendFileStatusToColor x:Key="StatusColor"/>
        <c:SendFileStatusToProgressColor x:Key="ProgressColor"/>
        <c:ShowProgressBarWhenInProgressOrDone x:Key="ShowProgress"/>
        <c:BoolToPassColor x:Key="BoolToPassColor"/>
        <c:BoolToHintColor x:Key="BoolToHintColor"/>
        <c:BoolToReadyTarget x:Key="BoolToReadyTarget"/>
        <c:BoolToReadyFile x:Key="BoolToReadyFile"/>
        <c:BoolToReadyState x:Key="BoolToReadyState"/>
        <c:BoolToOnlineDot x:Key="BoolToOnlineDot"/>
        <c:BoolToOnlineLabel x:Key="BoolToOnlineLabel"/>
        <c:DeviceTypeToGlyphConverter x:Key="DeviceTypeGlyph"/>
        <c:SendSessionStateToText x:Key="StateText"/>
        <c:BoolToSelectionBrush x:Key="PickBrush"/>
        <c:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
        <c:RefreshingTextConverter x:Key="RefreshingTextConverter"/>
        <c:BoolToVisibility x:Key="BoolToVisibility"/>
    </Page.Resources>

    <Grid Padding="24" RowDefinitions="Auto,Auto,*" Background="Transparent"
          AllowDrop="True" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">
        <Border x:Name="DropHighlightBorder" Margin="0" CornerRadius="14"
                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                BorderThickness="2" Background="{ThemeResource AccentFillColorDefaultBrush}"
                Opacity="0" IsHitTestVisible="False"/>

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="发送文件" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="选择目标设备和要发送的文件" FontSize="12" Opacity="0.6"/>
            </StackPanel>
        </Grid>

            <Grid Grid.Row="1" Margin="0,16,0,0" RowDefinitions="Auto,Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="选择目标设备" FontSize="16" FontWeight="SemiBold"/>
                        <Border Padding="8,2" CornerRadius="10" Background="{ThemeResource CardStrokeColorDefaultBrush}">
                            <TextBlock Text="{x:Bind ViewModel.Devices.Count, Mode=OneWay}" FontSize="11" Opacity="0.7"/>
                        </Border>
                    </StackPanel>
                    <Button Grid.Column="1" Command="{x:Bind ViewModel.RefreshDevicesCommand}"
                            IsEnabled="{x:Bind ViewModel.IsRefreshing, Converter={StaticResource InvertedBoolConverter}}"
                            Padding="8" Background="Transparent" BorderThickness="0"
                            ToolTipService.ToolTip="重新搜索（每 20 秒自动刷新）">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ProgressRing Width="14" Height="14" IsActive="{x:Bind ViewModel.IsRefreshing}"/>
                            <TextBlock Text="{x:Bind ViewModel.IsRefreshing, Converter={StaticResource RefreshingTextConverter}}" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Grid.Row="1" Margin="0,12,0,0" Padding="14,10" CornerRadius="10"
                        Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.9"
                        Visibility="{x:Bind ViewModel.SelectedTarget, Mode=OneWay, Converter={StaticResource NullToCollapsed}}">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="🎯" FontSize="16" AutomationProperties.AccessibilityView="Raw"/>
                            <TextBlock Text="{x:Bind ViewModel.SelectedTargetSummary, Mode=OneWay}"
                                       FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="清空选择" Padding="10,4" FontSize="12"
                                Click="OnDeselectTargetClick" Background="Transparent"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="2" x:Name="DeviceScroll" Margin="0,12,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{x:Bind ViewModel.HasDevices, Mode=OneWay}">
                    <!-- 官方网格布局：列间距(10)只存在于卡片之间，两侧零空隙，自动等宽铺满 -->
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Devices}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="300" MinItemHeight="120"
                                               MinColumnSpacing="10" MinRowSpacing="10"
                                               ItemsStretch="Fill"/>
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="14" CornerRadius="12" Margin="0"
                                        Tapped="OnDeviceTileTapped"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{Binding IsPicked, Mode=OneWay, Converter={StaticResource PickBrush}}"
                                        BorderThickness="1.5"
                                        AutomationProperties.Name="{Binding Alias}"
                                        AutomationProperties.HelpText="单击切换是否勾选该设备（可多选，群发给所有勾选设备）">
                                    <Border.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="加入白名单"
                                                            Click="OnAddToWhitelistClick"
                                                            DataContext="{Binding}"/>
                                            <MenuFlyoutItem Text="加入黑名单"
                                                            Click="OnAddToBlacklistClick"
                                                            DataContext="{Binding}"/>
                                        </MenuFlyout>
                                    </Border.ContextFlyout>
                                    <Grid ColumnDefinitions="3,42,*,Auto" VerticalAlignment="Center">
                                        <Border Grid.Column="0" Width="3" Height="42" CornerRadius="1.5"
                                                VerticalAlignment="Center" Margin="0,0,10,0"
                                                Background="{Binding IsOnline, Converter={StaticResource BoolToOnlineDot}}"/>
                                        <Border Grid.Column="1" Width="42" Height="42" CornerRadius="21"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DeviceType, Converter={StaticResource DeviceTypeGlyph}}"
                                                       FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="2" Margin="12,0,0,0" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Alias}" FontWeight="SemiBold" FontSize="14"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <TextBlock Text="🌐" FontSize="10" Opacity="0.7" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Ip}" Opacity="0.7" FontSize="11"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="·" Opacity="0.5" FontSize="11"/>
                                                <TextBlock Text="{Binding Port}" Opacity="0.7" FontSize="11"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding DeviceModel}" Opacity="0.5" FontSize="11"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4"
                                                    VerticalAlignment="Top" Margin="0,2,0,0">
                                            <Border Padding="5,1" CornerRadius="8"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    Visibility="{Binding IsPicked, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="✓" FontSize="9" Foreground="White"
                                                           AutomationProperties.AccessibilityView="Raw"/>
                                            </Border>
                                            <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                                     Fill="{Binding IsOnline, Converter={StaticResource BoolToOnlineDot}}"/>
                                            <TextBlock Text="{Binding IsOnline, Converter={StaticResource BoolToOnlineLabel}}"
                                                       FontSize="10" Opacity="0.7" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Margin="0,12,0,12" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.HasNoDevices, Mode=OneWay}">
                    <TextBlock Text="📡" FontSize="40" HorizontalAlignment="Center"/>
                    <TextBlock Text="正在搜索附近设备..." FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="确保目标设备开启 LocalSend 并连接同一 Wi-Fi"
                               FontSize="12" Opacity="0.6" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" Margin="0,12,0,0" RowDefinitions="Auto,*,Auto">
                <!-- 操作行：窄窗口自动换行（FlowPanel），避免按钮被截断/盖住 -->
                <ctrls:FlowPanel Grid.Row="0" HorizontalSpacing="8" VerticalSpacing="8">
                    <StackPanel x:Name="ImportingIndicator" Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Center" Visibility="Collapsed">
                        <ProgressRing Width="14" Height="14" IsActive="True" VerticalAlignment="Center"
                                      AutomationProperties.Name="正在导入文件"/>
                        <TextBlock Text="导入中…" FontSize="12" Opacity="0.7" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="📁 添加文件" Click="OnPickFilesClick"
                                Padding="14,0" Height="36" CornerRadius="8"/>
                        <Button Content="📂 添加文件夹" Click="OnPickFolderClick"
                                Padding="14,0" Height="36" CornerRadius="8"
                                ToolTipService.ToolTip="选择文件夹（保留目录结构发送）"/>
                        <Button Content="✏️ 文字" Click="OnSendTextClick"
                                Padding="14,0" Height="36" CornerRadius="8"
                                ToolTipService.ToolTip="发送文字/剪贴板内容（对方保存为 .txt）"/>
                    </StackPanel>
                    <Button Content="清空" Command="{x:Bind ViewModel.ClearFilesCommand}"
                            Padding="12,0" Height="36" CornerRadius="8"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.HasFiles, Mode=OneWay}"/>
                    <!-- PIN + 发送：窄时可随 FlowPanel 折行 -->
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Grid Width="110" VerticalAlignment="Center">
                            <PasswordBox x:Name="PinPasswordBox" PlaceholderText="PIN"
                                         Height="36" Padding="12,8" CornerRadius="8" FontSize="13"
                                         PasswordChanged="OnPinPasswordChanged"/>
                            <TextBox x:Name="PinVisibleBox" Visibility="Collapsed"
                                     Height="36" Padding="12,8" CornerRadius="8" FontSize="13"
                                     TextChanged="OnPinTextChanged"/>
                        </Grid>
                        <Button x:Name="PinToggleBtn" Width="40" Height="36" Padding="0"
                                Click="OnPinToggleClick" CornerRadius="8"
                                AutomationProperties.Name="显示或隐藏 PIN"
                                ToolTipService.ToolTip="显示/隐藏 PIN" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8D4;" FontSize="16"/>
                        </Button>
                    </StackPanel>
                    <Button Content="开始发送"
                            Command="{x:Bind ViewModel.StartSendCommand}"
                            AutomationProperties.Name="开始发送"
                            ToolTipService.ToolTip="{x:Bind ViewModel.SendDisabledHint, Mode=OneWay}"
                            Padding="24,0" Height="36" CornerRadius="10"
                            FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="🚀" FontSize="15" AutomationProperties.AccessibilityView="Raw"/>
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                </ctrls:FlowPanel>

                <Border Grid.Row="1" Margin="0,12,0,0" Padding="12" CornerRadius="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        MaxHeight="320">
                    <Grid>
                        <ListView ItemsSource="{x:Bind ViewModel.PendingFiles}" SelectionMode="None"
                                  Visibility="{x:Bind ViewModel.HasFiles, Mode=OneWay}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,3,0,3"/>
                                    <Setter Property="MinHeight" Value="48"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,8,12,8" CornerRadius="10"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <Grid ColumnDefinitions="Auto,40,*" VerticalAlignment="Center">
                                            <Border Grid.Column="0" Width="4" CornerRadius="2" MaxHeight="32"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.AccessibilityView="Raw"
                                                    Background="{Binding Status, Converter={StaticResource StatusColor}}"/>
                                            <Border Grid.Column="1" Width="40" Height="40" CornerRadius="10"
                                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0">
                                                <TextBlock Text="{Binding FileKind, Converter={StaticResource FileKindGlyph}}"
                                                           FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           AutomationProperties.AccessibilityView="Raw"/>
                                            </Border>
                                            <Grid Grid.Column="2" Margin="10,0,0,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding FileName}"
                                                               FontSize="13" FontWeight="SemiBold"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="1" FontSize="11" Opacity="0.6" VerticalAlignment="Center">
                                                        <Run Text="{Binding BytesSent, Mode=OneWay, Converter={StaticResource BytesToString}}"/>
                                                        <Run Text=" / "/>
                                                        <Run Text="{Binding Size, Mode=OneWay, Converter={StaticResource BytesToString}}"/>
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="2" FontSize="11" Opacity="0.65"
                                                               Text="{Binding Status}" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="3" FontSize="12" Padding="10,4" CornerRadius="6"
                                                            Content="移除" VerticalAlignment="Center" Margin="0,0,10,0"
                                                            ToolTipService.ToolTip="从列表移除"
                                                            Click="OnRemoveFileClick"
                                                            Visibility="{Binding Status, Converter={StaticResource PendingOnlyToVisible}}"/>
                                                </Grid>
                                                <ProgressBar Grid.Row="1" Margin="0,4,0,0" Height="4" CornerRadius="2"
                                                             AutomationProperties.Name="{Binding FileName}"
                                                             Maximum="{Binding Size}"
                                                             Value="{Binding BytesSent, Mode=OneWay}"
                                                             Foreground="{Binding Status, Converter={StaticResource ProgressColor}}"
                                                             Visibility="{Binding Status, Converter={StaticResource ShowProgress}}"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0,24"
                                    Visibility="{x:Bind ViewModel.HasNoFiles, Mode=OneWay}">
                            <TextBlock Text="📄" FontSize="40" HorizontalAlignment="Center"/>
                            <TextBlock Text="还没有选择文件" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="点击上方“添加文件”选择要发送的文件" FontSize="12" Opacity="0.6" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="0,20,0,0">

                    <!-- 状态卡：三条件横向并列（绿/红小圆点 + 文字），对齐项目记忆卡片风格 -->
                    <Border Padding="16,12" CornerRadius="12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                            <Grid Grid.Column="0" ColumnDefinitions="Auto,*">
                                <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center"
                                         Fill="{x:Bind ViewModel.HasSelectedTarget, Mode=OneWay, Converter={StaticResource BoolToPassColor}}"/>
                                <TextBlock Grid.Column="1" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center"
                                           Text="{x:Bind ViewModel.HasSelectedTarget, Mode=OneWay, Converter={StaticResource BoolToReadyTarget}}"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                            <Grid Grid.Column="1" ColumnDefinitions="Auto,*">
                                <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center"
                                         Fill="{x:Bind ViewModel.HasPendingFiles, Mode=OneWay, Converter={StaticResource BoolToPassColor}}"/>
                                <TextBlock Grid.Column="1" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center"
                                           Text="{x:Bind ViewModel.HasPendingFiles, Mode=OneWay, Converter={StaticResource BoolToReadyFile}}"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                            <Grid Grid.Column="2" ColumnDefinitions="Auto,*">
                                <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center"
                                         Fill="{x:Bind ViewModel.IsIdleOrFinished, Mode=OneWay, Converter={StaticResource BoolToPassColor}}"/>
                                <TextBlock Grid.Column="1" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center"
                                           Text="{x:Bind ViewModel.IsIdleOrFinished, Mode=OneWay, Converter={StaticResource BoolToReadyState}}"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
</Page>
