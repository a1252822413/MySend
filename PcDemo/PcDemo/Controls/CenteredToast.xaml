<?xml version="1.0" encoding="utf-8"?>
<!--
  CenteredToast：页面正中浮动的轻量提示卡片。
  改前问题：
    1) 外层半透明 DropShadowBorder 在白色背景下几乎不可见，和背景混成一片。
    2) 缺少遮罩层，Toast 视觉上"浮不起来"。
  改后：
    1) 卡片用纯实色（SolidBackgroundFillColorBaseBrush 本身不透明）+ 更深的描边，
       即使在最白的底色也能看清边缘。
    2) 增加全屏浅黑遮罩（Opacity ≈ 0.12），把背景"压暗"凸显 Toast，
       遮罩 IsHitTestVisible=False，不阻塞鼠标操作（只是纯视觉提示用）。
-->
<UserControl
    x:Class="PcDemo.Controls.CenteredToast"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Visibility="Collapsed">

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <!-- 全屏遮罩：28% 黑（#47000000，比旧版 12% 深一倍+，肉眼明显可见），不阻挡点击 -->
        <Border x:Name="OverlayMask"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="#47000000"
                Opacity="0"
                Visibility="Collapsed"
                IsHitTestVisible="False"/>

        <!-- Toast 卡片：纯实色背景 + 加粗描边，不再依赖半透明外框阴影 -->
        <Border x:Name="CardBorder"
                CornerRadius="16"
                MinWidth="300"
                MaxWidth="480"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1.2"
                RenderTransformOrigin="0.5,0.5"
                IsHitTestVisible="False">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="CardScale" ScaleX="0.94" ScaleY="0.94"/>
                </TransformGroup>
            </Border.RenderTransform>

            <Grid ColumnDefinitions="Auto,Auto,*">
                <!-- 左侧 5px 彩色竖条（按 ToastKind 染色） -->
                <Border x:Name="AccentBar"
                        Width="5"
                        CornerRadius="16,0,0,16"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"/>
                <!-- 图标容器（40×40，圆角 12，图标背景=彩色竖条的浅色版本） -->
                <Border x:Name="IconBorder"
                        Grid.Column="1"
                        Margin="18,20,14,20"
                        Width="42" Height="42" CornerRadius="12">
                    <FontIcon x:Name="IconGlyph"
                              FontSize="24"
                              Glyph="&#xE73E;"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <!-- 文字：标题 14 SemiBold + 正文 13 / Opacity 0.82，最多 3 行 -->
                <StackPanel Grid.Column="2"
                            Margin="0,20,24,20"
                            VerticalAlignment="Center" Spacing="4">
                    <TextBlock x:Name="TitleText" FontSize="14.5" FontWeight="SemiBold"
                               Text="{x:Bind Title, Mode=OneWay}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="MessageText" FontSize="13" Opacity="0.84"
                               Text="{x:Bind Message, Mode=OneWay}"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               MaxLines="3"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
