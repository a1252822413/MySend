<?xml version="1.0" encoding="utf-8"?>
<!-- 接收确认对话框：显示发送方信息 + 文件列表（CheckBox 多选），返回 PrepareUploadDecision -->
<!-- 样式：构造函数显式应用 DefaultContentDialogStyle（派生类不匹配隐式样式），与官方 ContentDialog 外观 100% 一致 -->
<ContentDialog
    x:Class="PcDemo.Views.ReceiveRequestDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="收到文件传输请求"
    PrimaryButtonText="接收"
    SecondaryButtonText="拒绝"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryClick"
    SecondaryButtonClick="OnSecondaryClick">

    <StackPanel Spacing="12" MinWidth="420">

        <!-- 发送方信息卡片 -->
        <Border Padding="14" CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid ColumnDefinitions="44,*">
                <!-- 发送方头像图标 -->
                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22"
                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <TextBlock Text="👤" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextOnAccentFillColorDefaultBrush}"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SenderAlias}" FontWeight="SemiBold" FontSize="15"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="🌐" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SenderIp}" Opacity="0.7" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 文件列表标题 + 汇总 -->
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="文件列表" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Border Grid.Column="1" Padding="8,3" CornerRadius="10"
                    Background="{ThemeResource AccentFillColorSecondaryBrush}">
                <TextBlock FontSize="11">
                    <Run Text="{Binding FileCount}"/>
                    <Run Text=" 个文件 · "/>
                    <Run Text="{Binding TotalDisplaySize}"/>
                </TextBlock>
            </Border>
        </Grid>

        <!-- 文件列表：固定列布局（勾选框 | 图标 | 文件名+大小），垂直居中对齐 -->
        <ListView ItemsSource="{Binding Files}"
                  SelectionMode="None"
                  MaxHeight="340"
                  IsItemClickEnabled="False">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0,2"/>
                    <Setter Property="MinHeight" Value="0"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="12,8" CornerRadius="6"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- 勾选框：固定列，垂直居中 -->
                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      MinWidth="0" Padding="0"
                                      VerticalAlignment="Center"/>
                            <!-- 文件类型图标：固定列，与勾选框间距 8 -->
                            <TextBlock Grid.Column="1" Text="{Binding FileIcon}" FontSize="20"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <!-- 文件名 + 大小：剩余宽度，与图标间距 10 -->
                            <StackPanel Grid.Column="2" Margin="10,0,0,0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FileName}" TextWrapping="Wrap"
                                           FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="{Binding DisplaySize}" Opacity="0.6" FontSize="11"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</ContentDialog>
