<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PcDemo.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:PcDemo.Models"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <!-- 空态图标脉动：与接收页同一节奏（呼吸式明暗），保持全应用一致 -->
        <Storyboard x:Name="EmptyPulseStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="EmptyPulseIcon"
                             Storyboard.TargetProperty="Opacity"
                             From="0.3" To="1.0" Duration="0:0:1.4" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Page.Resources>

    <Grid RowDefinitions="Auto,Auto,*" Padding="24">
        <!-- ① 标题行 -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="传输历史" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="收发文件完成后会自动记录在这里" FontSize="12" Opacity="0.6"/>
            </StackPanel>
            <Button Grid.Column="2" Click="OnClearClick" Padding="12,6" CornerRadius="8"
                    Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay}"
                    ToolTipService.ToolTip="清空全部传输记录（需二次确认）">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE74D;" FontSize="13" VerticalAlignment="Center"
                              AutomationProperties.AccessibilityView="Raw"/>
                    <TextBlock Text="清空记录" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ② 筛选栏：分段控件（方向）+ 搜索框 -->
        <Grid Grid.Row="1" Margin="0,14,0,0" ColumnDefinitions="Auto,*,Auto">
            <Border Grid.Column="0" Padding="2" CornerRadius="10" VerticalAlignment="Center"
                    Background="{ThemeResource ChipFillBrush}">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button Click="OnFilterAllClick" Content="全部" x:Name="FilterAllBtn"
                            Padding="14,5" CornerRadius="8" BorderThickness="0"/>
                    <Button Click="OnFilterSendClick" Content="发送" x:Name="FilterSendBtn"
                            Padding="14,5" CornerRadius="8" BorderThickness="0"/>
                    <Button Click="OnFilterReceiveClick" Content="接收" x:Name="FilterReceiveBtn"
                            Padding="14,5" CornerRadius="8" BorderThickness="0"/>
                </StackPanel>
            </Border>
            <TextBox Grid.Column="2" x:Name="SearchBox" Width="240" PlaceholderText="搜索设备名 / 文件名"
                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     CornerRadius="8" Padding="12,8"/>
        </Grid>

        <ListView Grid.Row="2" Margin="0,14,0,0" ItemsSource="{x:Bind ViewModel.FilteredItems, Mode=OneWay}" SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="MinHeight" Value="0"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="m:TransferHistoryItem">
                    <Border Margin="0,0,0,8" Padding="14,12" CornerRadius="12"
                            PointerEntered="OnItemPointerEntered"
                            PointerExited="OnItemPointerExited"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Border.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="查看文件明细" Click="OnShowDetailsClick"
                                                DataContext="{Binding}"/>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem Text="复制保存路径" Click="OnCopyPathClick"
                                                DataContext="{Binding}"/>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem Text="删除这条记录" Click="OnDeleteHistoryClick"
                                                DataContext="{Binding}"/>
                            </MenuFlyout>
                        </Border.ContextFlyout>
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                            <!-- 方向图标瓦片（品牌绿圆底 + 单色字形） -->
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" VerticalAlignment="Center"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}">
                                <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="16"
                                          Foreground="{ThemeResource TextOnAccentFillColorDefaultBrush}"
                                          AutomationProperties.AccessibilityView="Raw"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind PeerText}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock FontSize="11.5" Opacity="0.65" TextTrimming="CharacterEllipsis">
                                    <Run Text="{x:Bind FilesText}"/><Run Text=" · "/><Run Text="{x:Bind SizeText}"/>
                                    <Run Text=" · "/><Run Text="{x:Bind FirstFileName}"/>
                                </TextBlock>
                            </StackPanel>
                            <!-- 状态 chip：浅底深字（系统语义色），深浅主题自适应 -->
                            <Border Grid.Column="2" Padding="8,3" CornerRadius="9" VerticalAlignment="Center"
                                    Background="{x:Bind StatusBackgroundBrush}">
                                <TextBlock Text="{x:Bind StatusText}" FontSize="11"
                                           Foreground="{x:Bind StatusForegroundBrush}"/>
                            </Border>
                            <TextBlock Grid.Column="3" Text="{x:Bind TimeText}" FontSize="11.5" Opacity="0.6" VerticalAlignment="Center"/>
                            <Button Grid.Column="4" Click="OnOpenFolderClick"
                                    Padding="8,4" CornerRadius="6" FontSize="11.5"
                                    VerticalAlignment="Center"
                                    Visibility="{x:Bind OpenFolderVisibility}"
                                    ToolTipService.ToolTip="在资源管理器中打开保存位置">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="12" VerticalAlignment="Center"
                                              AutomationProperties.AccessibilityView="Raw"/>
                                    <TextBlock Text="打开位置" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- ③ 空态：图标 + 文案（脉动） -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
            <FontIcon x:Name="EmptyPulseIcon" Glyph="&#xE81C;" FontSize="40"
                      Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                      AutomationProperties.AccessibilityView="Raw"/>
            <TextBlock Text="暂无传输记录" FontSize="14" FontWeight="SemiBold" Opacity="0.75" HorizontalAlignment="Center"/>
            <TextBlock Text="收发文件完成后会自动记录在这里" FontSize="11.5" Opacity="0.5" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Page>
