<?xml version="1.0" encoding="utf-8"?>
<!-- 接收进度对话框：环形进度 + 阶段/速度/剩余时间；PrimaryButton"取消接收" → 二次确认面板（不关闭对话框） -->
<ContentDialog
    x:Class="PcDemo.Views.ReceiveProgressDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="正在接收文件"
    PrimaryButtonText="取消接收"
    PrimaryButtonClick="OnCancelClick"
    SecondaryButtonClick="OnContinueClick">

    <Grid MinWidth="400">
        <!-- 进度面板：二次确认时保持显示（确认按钮在底部命令区切换） -->
        <StackPanel Spacing="14" Padding="0,4,0,0">
            <!-- 计算属性(SenderText/Ring/FilesText/StatText)不做 x:Bind：由 P.PropertyChanged →
                 OnProgressChanged → RefreshUi() 只更新变化节点。P.* 实现 INPC 保持自动绑定。 -->
            <Border HorizontalAlignment="Center" Padding="10,3" CornerRadius="10"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}">
                <TextBlock x:Name="SenderTextBlock" FontSize="12" Opacity="0.85"/>
            </Border>
            <Grid Width="104" Height="104" HorizontalAlignment="Center">
                <ProgressRing x:Name="ProgressRingControl" Width="104" Height="104"
                              Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                              IsIndeterminate="{x:Bind P.IsIndeterminate, Mode=OneWay}"/>
                <!-- 不确定态（准备/校验阶段）无百分比可显示，数字由 code-behind 隐藏 -->
                <TextBlock x:Name="RingPercentTextBlock" FontSize="22" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <StackPanel Spacing="4" HorizontalAlignment="Center">
                <TextBlock x:Name="PhaseTextBlock" FontSize="15" FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Text="{x:Bind P.PhaseText, Mode=OneWay}"/>
                <TextBlock x:Name="FilesTextBlock" FontSize="12" Opacity="0.7"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="StatTextBlock" FontSize="12" Opacity="0.75"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</ContentDialog>
