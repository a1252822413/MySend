<?xml version="1.0" encoding="utf-8"?>
<!--
  接收进度对话框（design/unified v1.3 FileProgressList）
  总进度按「已收字节 / 总字节」，文件进度按每个 ReceiveFile 的 BytesReceived / Metadata.Size，
  每个文件一条独立进度条；列表独立滚动，SHA-256 边写边校验。
-->
<ContentDialog
    x:Class="PcDemo.Views.ReceiveProgressDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="正在接收文件"
    PrimaryButtonText="取消接收"
    PrimaryButtonClick="OnCancelClick"
    SecondaryButtonClick="OnContinueClick">

    <Grid MinWidth="400">
        <StackPanel Spacing="{StaticResource GapBlock}" Padding="0,4,0,0">
            <!-- 计算属性(SenderText/Ring/FilesText/StatText)不做 x:Bind：由 P.PropertyChanged →
                 OnProgressChanged → RefreshUi() 只更新变化节点。P.* 实现 INPC 保持自动绑定。 -->
            <Border HorizontalAlignment="Left" Padding="{StaticResource SpaceChip}"
                    CornerRadius="{StaticResource RadiusControl}"
                    Background="{ThemeResource ChipFillBrush}">
                <TextBlock x:Name="SenderTextBlock" FontSize="{StaticResource FontSm}"
                           Foreground="{ThemeResource BrandTextDimBrush}"/>
            </Border>

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource GapSection}">
                <Grid Width="96" Height="96" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressRing x:Name="ProgressRingControl" Width="96" Height="96"
                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                  Background="{ThemeResource ControlStrokeColorSecondaryBrush}"
                                  IsIndeterminate="{x:Bind P.IsIndeterminate, Mode=OneWay}"/>
                    <TextBlock x:Name="RingPercentTextBlock" FontSize="{StaticResource FontH1}" FontWeight="SemiBold"
                               Foreground="{ThemeResource BrandTextBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel Grid.Column="1" Spacing="{StaticResource GapMicro}" VerticalAlignment="Center">
                    <TextBlock x:Name="PhaseTextBlock" FontSize="{StaticResource FontH2}" FontWeight="SemiBold"
                               Text="{x:Bind P.PhaseText, Mode=OneWay}"/>
                    <TextBlock x:Name="FilesTextBlock" FontSize="{StaticResource FontSm}"
                               Foreground="{ThemeResource BrandTextDimBrush}"/>
                    <TextBlock x:Name="StatTextBlock" FontSize="{StaticResource FontSm}"
                               Foreground="{ThemeResource BrandTextDimBrush}"/>
                    <ProgressBar x:Name="TotalProgressBar" Height="8" Minimum="0" Maximum="100" Value="0"
                                 CornerRadius="{StaticResource RadiusXs}"
                                 Foreground="{ThemeResource BrandAccentFillBrush}"
                                 Background="{ThemeResource BrandSurface3Brush}"
                                 AutomationProperties.Name="总进度（按字节）"/>
                </StackPanel>
            </Grid>

            <!-- 文件进度：每个文件一条独立进度条 -->
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="{StaticResource GapControl}">
                <TextBlock Text="文件进度" Style="{StaticResource SectionTitleStyle}"/>
                <Border Padding="{StaticResource SpaceChip}" CornerRadius="{StaticResource RadiusControl}"
                        Background="{ThemeResource ChipFillBrush}">
                    <TextBlock x:Name="FileCountTextBlock" Text="0" FontSize="{StaticResource FontLabel}"
                               Foreground="{ThemeResource BrandTextDimBrush}"/>
                </Border>
                <TextBlock Text="SHA-256 边写边校验" Style="{StaticResource CaptionTextStyle}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
            <ScrollViewer MaxHeight="{StaticResource FileListMaxHeight}"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="FileListPanel" Spacing="{StaticResource GapControl}"/>
            </ScrollViewer>

            <TextBlock x:Name="DestinationTextBlock" FontSize="{StaticResource FontLabel}"
                       Foreground="{ThemeResource BrandTextMuteBrush}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
    </Grid>
</ContentDialog>
