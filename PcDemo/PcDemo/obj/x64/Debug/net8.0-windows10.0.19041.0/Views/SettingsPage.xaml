<?xml version="1.0" encoding="utf-8"?>
<Page x:ConnectionId='1'
    x:Class="PcDemo.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16">

            <!-- 页面标题 -->
            <StackPanel Spacing="2" Margin="0,0,0,8">
                <TextBlock Text="设置" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="调整 PcDemo 的传输参数和外观偏好" FontSize="12" Opacity="0.6"/>
            </StackPanel>

            <!-- 设备身份 -->
            <Border Padding="18,14" CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="14">
                    <TextBlock Text="设备身份" FontSize="14" FontWeight="SemiBold" Opacity="0.85"/>
                    <Grid ColumnDefinitions="160,*,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="本机显示名" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBox x:ConnectionId='14'                                                                                  
                                     PlaceholderText="手机端 App 上看到的你的设备名"/>
                            <TextBlock Text="默认主机名；发送/接收时对方会看到这个名字。" Opacity="0.6" FontSize="12"/>
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="160,*,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="设备模型" VerticalAlignment="Center"/>
                        <TextBox x:ConnectionId='13' Grid.Column="1"                                                                                        />
                    </Grid>
                    <Grid ColumnDefinitions="160,*,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="设备类型" VerticalAlignment="Center"/>
                        <ComboBox x:ConnectionId='12' Grid.Column="1"                                                       
                                                                                           />
                    </Grid>
                    <Grid ColumnDefinitions="160,*,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="设备指纹" VerticalAlignment="Center"/>
                        <TextBox x:ConnectionId='11' Grid.Column="1"                                                   
                                 IsReadOnly="True" Opacity="0.6"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 连接参数 -->
            <Border Padding="18,14" CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="14">
                    <TextBlock Text="连接参数" FontSize="14" FontWeight="SemiBold" Opacity="0.85"/>
                    <Grid ColumnDefinitions="160,*,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="服务端口" VerticalAlignment="Center"/>
                        <NumberBox x:ConnectionId='10' Grid.Column="1"                                             
                                   Minimum="1" Maximum="65535" SpinButtonPlacementMode="Compact"/>
                    </Grid>
                    <Grid ColumnDefinitions="160,*,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="多播组" VerticalAlignment="Center"/>
                        <TextBox x:ConnectionId='9' Grid.Column="1"                                                                                           />
                    </Grid>
                    <Grid ColumnDefinitions="160,*,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="接收保存目录" VerticalAlignment="Center"/>
                        <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                            <TextBox x:ConnectionId='7' Grid.Column="0"                                                                                        />
                            <Button x:ConnectionId='8' Grid.Column="1" Content="浏览..."                                  Margin="8,0,0,0"/>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 外观 -->
            <Border Padding="18,14" CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="14">
                    <TextBlock Text="外观" FontSize="14" FontWeight="SemiBold" Opacity="0.85"/>
                    <Grid ColumnDefinitions="160,*,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="主题模式" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <RadioButtons x:ConnectionId='6'                                                           MaxColumns="3">
                                <RadioButton Content="跟随系统"/>
                                <RadioButton Content="浅色"/>
                                <RadioButton Content="深色"/>
                            </RadioButtons>
                            <TextBlock Text="保存后立即切换；下次启动保留偏好。" Opacity="0.6" FontSize="12"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 系统 -->
            <Border Padding="18,14" CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="14">
                    <TextBlock Text="系统" FontSize="14" FontWeight="SemiBold" Opacity="0.85"/>
                    <Grid ColumnDefinitions="160,*,Auto" VerticalAlignment="Center">
                        <StackPanel Grid.Column="0" Spacing="1">
                            <TextBlock Text="开机自启" VerticalAlignment="Center"/>
                            <TextBlock Text="登录 Windows 后自动启动 PcDemo。" Opacity="0.5" FontSize="11"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <ToggleSwitch x:ConnectionId='4'                                                         
                                          OnContent="开" OffContent="关"/>
                            <TextBlock x:ConnectionId='5'                                                       Opacity="0.65" FontSize="12"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 操作栏 -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                <TextBlock x:ConnectionId='2' Grid.Column="0"                                                  
                           VerticalAlignment="Center" Opacity="0.7"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button x:ConnectionId='3' Content="保存更改"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            Foreground="{ThemeResource TextOnAccentFillColorDefaultBrush}"
                            Padding="20,8" CornerRadius="8"
                                                                    />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>

