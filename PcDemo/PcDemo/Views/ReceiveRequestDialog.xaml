<?xml version="1.0" encoding="utf-8"?>
<!-- 接收确认对话框：显示发送方信息 + 文件列表（CheckBox 多选），返回 PrepareUploadDecision -->
<!-- 样式：构造函数显式应用 DefaultContentDialogStyle（派生类不匹配隐式样式），与官方 ContentDialog 外观 100% 一致 -->
<ContentDialog
    x:Class="PcDemo.Views.ReceiveRequestDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="收到文件传输请求"
    PrimaryButtonText="接收"
    SecondaryButtonText="拒绝"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryClick"
    SecondaryButtonClick="OnSecondaryClick">

    <StackPanel Spacing="{StaticResource GapBlock}" MinWidth="420">

        <!-- 发送方信息卡片 -->
        <Border Padding="{StaticResource SpaceCardCompact}" CornerRadius="{StaticResource RadiusControl}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid ColumnDefinitions="44,*">
                <!-- 发送方头像图标 -->
                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="{StaticResource RadiusCard}"
                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <FontIcon Glyph="&#xE77B;" FontSize="{StaticResource FontH2}"
                              Foreground="{ThemeResource TextOnAccentFillColorDefaultBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              AutomationProperties.Name="发送方头像"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="{StaticResource GapMicro}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SenderAlias}" FontWeight="SemiBold" FontSize="{StaticResource FontH2}"/>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControl}">
                        <FontIcon Glyph="&#xE774;" FontSize="{StaticResource FontLabel}" Opacity="0.7" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SenderIp}" Foreground="{ThemeResource BrandTextDimBrush}" FontSize="{StaticResource FontSm}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 文件列表标题 + 全选/全不选 + 已选汇总 -->
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource GapControl}">
            <TextBlock Grid.Column="0" Text="文件列表" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource GapMicro}" VerticalAlignment="Center">
                <Button Content="全选" Click="OnSelectAllClick"
                        Padding="{StaticResource SpaceChip}" FontSize="{StaticResource FontLabel}" CornerRadius="{StaticResource RadiusControl}"
                        Background="Transparent"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"/>
                <Button Content="全不选" Click="OnSelectNoneClick"
                        Padding="{StaticResource SpaceChip}" FontSize="{StaticResource FontLabel}" CornerRadius="{StaticResource RadiusControl}"
                        Background="Transparent"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"/>
            </StackPanel>
            <Border Grid.Column="2" Padding="{StaticResource SpaceChip}" CornerRadius="{StaticResource RadiusRow}"
                    Background="{ThemeResource AccentFillColorSecondaryBrush}">
                <TextBlock Text="{Binding SelectedSummaryText}" FontSize="{StaticResource FontLabel}"/>
            </Border>
        </Grid>

        <!-- 文件列表：固定列布局（勾选框 | 图标 | 文件名+大小），垂直居中对齐 -->
        <ListView ItemsSource="{Binding Files}"
                  SelectionMode="None"
                  MaxHeight="340"
                  IsItemClickEnabled="False">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0,2"/>
                    <Setter Property="MinHeight" Value="0"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="{StaticResource SpaceRow}" CornerRadius="{StaticResource RadiusControl}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- 勾选框：固定列，垂直居中 -->
                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      AutomationProperties.Name="{Binding FileName}"
                                      MinWidth="0" Padding="{StaticResource SpaceZero}"
                                      VerticalAlignment="Center"/>
                            <!-- 文件类型图标：固定列，与勾选框间距 8（PUA 字形需 Fluent Icons 字体） -->
                            <TextBlock Grid.Column="1" Text="{Binding FileIcon}" FontSize="{StaticResource FontH2}"
                                       FontFamily="Segoe Fluent Icons"
                                       Margin="8,0,0,0" VerticalAlignment="Center"
                                       AutomationProperties.AccessibilityView="Raw"/>
                            <!-- 文件名 + 大小：剩余宽度，与图标间距 10 -->
                            <StackPanel Grid.Column="2" Margin="8,0,0,0" Spacing="{StaticResource GapMicro}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FileName}" TextWrapping="Wrap"
                                           FontWeight="SemiBold" FontSize="{StaticResource FontBody}"/>
                                <TextBlock Text="{Binding DisplaySize}" Foreground="{ThemeResource BrandTextMuteBrush}" FontSize="{StaticResource FontLabel}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</ContentDialog>
