<?xml version="1.0" encoding="utf-8"?>
<!-- 接收进度对话框：环形进度 + 阶段/速度/剩余时间；PrimaryButton"取消接收" → 二次确认面板（不关闭对话框） -->
<ContentDialog
    x:Class="PcDemo.Views.ReceiveProgressDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="正在接收文件"
    PrimaryButtonText="取消接收"
    PrimaryButtonClick="OnCancelClick"
    SecondaryButtonClick="OnContinueClick">

    <Grid MinWidth="400">
        <!-- 进度面板：二次确认时保持显示（确认按钮在底部命令区切换） -->
        <StackPanel Spacing="14" Padding="0,4,0,0">
            <TextBlock Text="{x:Bind SenderText, Mode=OneWay}" FontSize="14" Opacity="0.8"
                       HorizontalAlignment="Center"/>
            <ProgressRing Width="84" Height="84"
                          IsIndeterminate="{x:Bind P.IsIndeterminate, Mode=OneWay}"
                          Value="{x:Bind RingValue, Mode=OneWay}"/>
            <StackPanel Spacing="4" HorizontalAlignment="Center">
                <TextBlock Text="{x:Bind P.PhaseText, Mode=OneWay}" FontSize="15" FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{x:Bind FilesText, Mode=OneWay}" FontSize="12" Opacity="0.7"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{x:Bind StatText, Mode=OneWay}" FontSize="12" Opacity="0.75"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</ContentDialog>
