<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PcDemo.Views.DeviceListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    NavigationCacheMode="Enabled"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:PcDemo.Models"
    xmlns:c="using:PcDemo.Converters"
    Background="Transparent">

    <Page.Resources>
        <c:EmptyToCollapsed x:Key="EmptyToCollapsed"/>
        <c:DeviceTypeToGlyphConverter x:Key="DeviceTypeGlyph"/>
        <c:BoolToVisibility x:Key="BoolToVisibility"/>
        <c:InvertedBoolToVisibility x:Key="InvertedBoolToVisibility"/>
    </Page.Resources>

    <ScrollViewer Padding="{StaticResource SpacePage}" HorizontalScrollBarVisibility="Disabled">
        <!-- 同 SettingsPage：ScrollViewer 内不可用 MaxWidth + HorizontalAlignment=Left
             （星号列测量/排布宽度不一致会触发布局循环） -->
        <StackPanel Spacing="{StaticResource GapSection}">

            <!-- 页面标题 -->
            <StackPanel Spacing="{StaticResource GapMicro}" Margin="0,0,0,8">
                <TextBlock Text="设备管理" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="白名单设备免确认接收并可单独开启自动接收；黑名单设备在 HTTP 层直接拒绝" Style="{StaticResource PageSubtitleStyle}"/>
            </StackPanel>

            <!-- 统计条：设计稿 stat-strip（白名单数 / 黑名单数 / 仅白名单模式） -->
            <Border Padding="{StaticResource SpaceCardCompact}" CornerRadius="{StaticResource RadiusCard}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="{StaticResource GapSection}">
                    <StackPanel Grid.Column="0" Spacing="{StaticResource GapMicro}">
                        <TextBlock Text="白名单" Style="{StaticResource CaptionTextStyle}"/>
                        <TextBlock Text="{x:Bind ViewModel.WhitelistCount, Mode=OneWay}"
                                   FontSize="{StaticResource FontH1}" FontWeight="SemiBold"
                                   Foreground="{ThemeResource BrandAccentInkBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="{StaticResource GapMicro}">
                        <TextBlock Text="黑名单" Style="{StaticResource CaptionTextStyle}"/>
                        <TextBlock Text="{x:Bind ViewModel.BlacklistCount, Mode=OneWay}"
                                   FontSize="{StaticResource FontH1}" FontWeight="SemiBold"
                                   Foreground="{ThemeResource BrandTextBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="{StaticResource GapMicro}" VerticalAlignment="Center">
                        <TextBlock Text="仅白名单模式" Style="{StaticResource CaptionTextStyle}"/>
                        <!-- 开/关两态互斥：已启用用绿色语义，未启用用中性色，避免「未开启」误显示为成功态 -->
                        <Border Padding="{StaticResource SpaceChip}" CornerRadius="{StaticResource RadiusControl}"
                                HorizontalAlignment="Left"
                                Background="{ThemeResource BrandSuccessSoftBrush}"
                                Visibility="{x:Bind ViewModel.WhitelistOnly, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{x:Bind ViewModel.WhitelistOnlyText, Mode=OneWay}"
                                       FontSize="{StaticResource FontLabel}"
                                       Foreground="{ThemeResource BrandAccentInkBrush}"/>
                        </Border>
                        <Border Padding="{StaticResource SpaceChip}" CornerRadius="{StaticResource RadiusControl}"
                                HorizontalAlignment="Left"
                                Background="{ThemeResource ChipFillBrush}"
                                BorderBrush="{ThemeResource ChipStrokeBrush}" BorderThickness="1"
                                Visibility="{x:Bind ViewModel.WhitelistOnly, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibility}}">
                            <TextBlock Text="{x:Bind ViewModel.WhitelistOnlyText, Mode=OneWay}"
                                       FontSize="{StaticResource FontLabel}"
                                       Foreground="{ThemeResource BrandTextDimBrush}"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 添加设备（共用） -->
            <Border Padding="{StaticResource SpaceCard}" CornerRadius="{StaticResource RadiusCard}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="{StaticResource GapBlock}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControl}">
                        <FontIcon Glyph="&#xE710;" FontSize="{StaticResource FontH2}" VerticalAlignment="Center"
                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                  AutomationProperties.AccessibilityView="Raw"/>
                        <TextBlock Text="添加设备" FontSize="{StaticResource FontH2}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 从已发现设备选 -->
                    <Grid ColumnDefinitions="160,*,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="已发现设备" VerticalAlignment="Center" Foreground="{ThemeResource BrandTextDimBrush}"/>
                        <ComboBox Grid.Column="1" ItemsSource="{x:Bind ViewModel.DiscoveredDevices, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedDiscovered, Mode=TwoWay}"
                                  DisplayMemberPath="Alias"
                                  PlaceholderText="点击刷新或选择设备" HorizontalAlignment="Stretch"/>
                        <Button Grid.Column="2" Click="OnRefreshDiscoveredClick" Margin="8,0,0,0"
                                Padding="{StaticResource SpaceRow}" CornerRadius="{StaticResource RadiusControl}" ToolTipService.ToolTip="重新读取附近设备列表">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControl}">
                                <FontIcon Glyph="&#xE72C;" FontSize="{StaticResource FontBody}" VerticalAlignment="Center"
                                          AutomationProperties.AccessibilityView="Raw"/>
                                <TextBlock Text="刷新" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Grid ColumnDefinitions="160,Auto,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="加入（已发现）" VerticalAlignment="Center" Foreground="{ThemeResource BrandTextDimBrush}"/>
                        <Button Grid.Column="1" Click="OnAddWhitelistFromDiscoveredClick"
                                Padding="{StaticResource SpaceRow}" CornerRadius="{StaticResource RadiusControl}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControl}">
                                <FontIcon Glyph="&#xE73E;" FontSize="{StaticResource FontBody}" VerticalAlignment="Center"
                                          AutomationProperties.AccessibilityView="Raw"/>
                                <TextBlock Text="白名单" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Click="OnAddBlacklistFromDiscoveredClick"
                                Padding="{StaticResource SpaceRow}" CornerRadius="{StaticResource RadiusControl}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControl}">
                                <FontIcon Glyph="&#xE8F8;" FontSize="{StaticResource FontBody}" VerticalAlignment="Center"
                                          AutomationProperties.AccessibilityView="Raw"/>
                                <TextBlock Text="黑名单" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- 手动输入（离线设备） -->
                    <Grid ColumnDefinitions="160,*,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="设备指纹" VerticalAlignment="Center" Foreground="{ThemeResource BrandTextDimBrush}"/>
                        <TextBox Grid.Column="1" Text="{x:Bind ViewModel.NewFingerprint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="粘贴对方 fingerprint"/>
                    </Grid>
                    <Grid ColumnDefinitions="160,*,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="别名（可选）" VerticalAlignment="Center" Foreground="{ThemeResource BrandTextDimBrush}"/>
                        <TextBox Grid.Column="1" Text="{x:Bind ViewModel.NewAlias, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="便于识别的名字"/>
                    </Grid>
                    <Grid ColumnDefinitions="160,Auto,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="加入（手动）" VerticalAlignment="Center" Foreground="{ThemeResource BrandTextDimBrush}"/>
                        <Button Grid.Column="1" Click="OnAddWhitelistManualClick"
                                Padding="{StaticResource SpaceRow}" CornerRadius="{StaticResource RadiusControl}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControl}">
                                <FontIcon Glyph="&#xE73E;" FontSize="{StaticResource FontBody}" VerticalAlignment="Center"
                                          AutomationProperties.AccessibilityView="Raw"/>
                                <TextBlock Text="白名单" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Click="OnAddBlacklistManualClick"
                                Padding="{StaticResource SpaceRow}" CornerRadius="{StaticResource RadiusControl}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControl}">
                                <FontIcon Glyph="&#xE8F8;" FontSize="{StaticResource FontBody}" VerticalAlignment="Center"
                                          AutomationProperties.AccessibilityView="Raw"/>
                                <TextBlock Text="黑名单" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- 操作结果提示：语义色状态条 -->
                    <Border Padding="{StaticResource SpaceRow}" CornerRadius="{StaticResource RadiusControl}"
                            Background="{ThemeResource ChipFillBrush}"
                            Visibility="{x:Bind ViewModel.StatusText, Mode=OneWay, Converter={StaticResource EmptyToCollapsed}}">
                        <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" FontSize="{StaticResource FontSm}" Foreground="{ThemeResource BrandTextDimBrush}"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 白名单 -->
            <Border Padding="{StaticResource SpaceCard}" CornerRadius="{StaticResource RadiusCard}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="{StaticResource GapControl}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControl}">
                        <FontIcon Glyph="&#xE73E;" FontSize="{StaticResource FontH2}" VerticalAlignment="Center"
                                  Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                  AutomationProperties.AccessibilityView="Raw"/>
                        <TextBlock Text="白名单" FontSize="{StaticResource FontH2}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="白名单设备不会被自动拒绝；勾选「自动接收」可跳过确认弹窗直接保存文件。" Foreground="{ThemeResource BrandTextMuteBrush}" FontSize="{StaticResource FontSm}"/>

                    <!-- 空态 -->
                    <Border Padding="24,16" CornerRadius="{StaticResource RadiusControl}"
                            Background="{ThemeResource SubtleFillColorTransparentBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            Visibility="{x:Bind ViewModel.HasNoWhitelist, Mode=OneWay}">
                        <StackPanel Spacing="{StaticResource GapControl}" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE8FB;" FontSize="24" Opacity="0.4" HorizontalAlignment="Center"
                                      AutomationProperties.AccessibilityView="Raw"/>
                            <TextBlock Text="白名单为空" FontSize="{StaticResource FontBody}" Foreground="{ThemeResource BrandTextDimBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="从上方选择已发现设备，或粘贴指纹手动加入" FontSize="{StaticResource FontSm}" Foreground="{ThemeResource BrandTextMuteBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <ListView ItemsSource="{x:Bind ViewModel.Whitelist, Mode=OneWay}"
                              SelectionMode="None" HorizontalContentAlignment="Stretch">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="MinHeight" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:DeviceListEntry">
                                <Border Padding="{StaticResource SpaceCardCompact}" CornerRadius="{StaticResource RadiusRow}"
                                        Background="{ThemeResource SubtleFillColorTransparentBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="{StaticResource GapBlock}" VerticalAlignment="Center">
                                        <!-- 设备类型头像瓦片 -->
                                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="{StaticResource RadiusCard}"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind DeviceType, Mode=OneWay, Converter={StaticResource DeviceTypeGlyph}}"
                                                       FontFamily="Segoe Fluent Icons" FontSize="{StaticResource FontH2}"
                                                       Foreground="{ThemeResource TextOnAccentFillColorDefaultBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       AutomationProperties.AccessibilityView="Raw"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="{StaticResource GapMicro}" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Alias, Mode=OneWay}" FontWeight="SemiBold" FontSize="{StaticResource FontBody}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{x:Bind Fingerprint, Mode=OneWay}" Foreground="{ThemeResource BrandTextMuteBrush}" FontSize="{StaticResource FontLabel}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="2" Header="自动接收" OffContent="关" OnContent="开"
                                                      IsOn="{x:Bind AutoAccept, Mode=OneWay}"
                                                      Toggled="OnWhitelistAutoAcceptToggled"
                                                      DataContext="{x:Bind}"/>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="{StaticResource GapControl}">
                                            <Button Click="OnRenameWhitelistClick"
                                                    DataContext="{x:Bind}" Padding="{StaticResource SpaceControl}" CornerRadius="{StaticResource RadiusControl}"
                                                    ToolTipService.ToolTip="修改本地显示名称">
                                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControl}">
                                                    <FontIcon Glyph="&#xE70F;" FontSize="{StaticResource FontSm}" VerticalAlignment="Center"
                                                              AutomationProperties.AccessibilityView="Raw"/>
                                                    <TextBlock Text="重命名" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Click="OnRemoveWhitelistClick"
                                                    DataContext="{x:Bind}" Padding="{StaticResource SpaceControl}" CornerRadius="{StaticResource RadiusControl}"
                                                    ToolTipService.ToolTip="从白名单移除">
                                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControl}">
                                                    <FontIcon Glyph="&#xE738;" FontSize="{StaticResource FontSm}" VerticalAlignment="Center"
                                                              AutomationProperties.AccessibilityView="Raw"/>
                                                    <TextBlock Text="移除" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- 黑名单 -->
            <Border Padding="{StaticResource SpaceCard}" CornerRadius="{StaticResource RadiusCard}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="{StaticResource GapControl}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControl}">
                        <FontIcon Glyph="&#xE8F8;" FontSize="{StaticResource FontH2}" VerticalAlignment="Center"
                                  Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                  AutomationProperties.AccessibilityView="Raw"/>
                        <TextBlock Text="黑名单" FontSize="{StaticResource FontH2}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="黑名单设备的文件请求会在 HTTP 层直接拒绝（403 Blocked by blacklist）。" Foreground="{ThemeResource BrandTextMuteBrush}" FontSize="{StaticResource FontSm}"/>

                    <!-- 空态 -->
                    <Border Padding="24,16" CornerRadius="{StaticResource RadiusControl}"
                            Background="{ThemeResource SubtleFillColorTransparentBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            Visibility="{x:Bind ViewModel.HasNoBlacklist, Mode=OneWay}">
                        <StackPanel Spacing="{StaticResource GapControl}" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE8F8;" FontSize="24" Opacity="0.4" HorizontalAlignment="Center"
                                      AutomationProperties.AccessibilityView="Raw"/>
                            <TextBlock Text="黑名单为空" FontSize="{StaticResource FontBody}" Foreground="{ThemeResource BrandTextDimBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="被拉黑的设备将无法向本机发送任何文件" FontSize="{StaticResource FontSm}" Foreground="{ThemeResource BrandTextMuteBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <ListView ItemsSource="{x:Bind ViewModel.Blacklist, Mode=OneWay}"
                              SelectionMode="None" HorizontalContentAlignment="Stretch">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="MinHeight" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:DeviceListEntry">
                                <Border Padding="{StaticResource SpaceCardCompact}" CornerRadius="{StaticResource RadiusRow}"
                                        Background="{ThemeResource SubtleFillColorTransparentBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource GapBlock}" VerticalAlignment="Center">
                                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="{StaticResource RadiusCard}"
                                                Background="{ThemeResource ChipFillBrush}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind DeviceType, Mode=OneWay, Converter={StaticResource DeviceTypeGlyph}}"
                                                       FontFamily="Segoe Fluent Icons" FontSize="{StaticResource FontH2}" Opacity="0.75"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       AutomationProperties.AccessibilityView="Raw"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="{StaticResource GapMicro}" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Alias, Mode=OneWay}" FontWeight="SemiBold" FontSize="{StaticResource FontBody}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{x:Bind Fingerprint, Mode=OneWay}" Foreground="{ThemeResource BrandTextMuteBrush}" FontSize="{StaticResource FontLabel}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{StaticResource GapControl}">
                                            <Button Click="OnRenameBlacklistClick"
                                                    DataContext="{x:Bind}" Padding="{StaticResource SpaceControl}" CornerRadius="{StaticResource RadiusControl}"
                                                    ToolTipService.ToolTip="修改本地显示名称">
                                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControl}">
                                                    <FontIcon Glyph="&#xE70F;" FontSize="{StaticResource FontSm}" VerticalAlignment="Center"
                                                              AutomationProperties.AccessibilityView="Raw"/>
                                                    <TextBlock Text="重命名" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Click="OnRemoveBlacklistClick"
                                                    DataContext="{x:Bind}" Padding="{StaticResource SpaceControl}" CornerRadius="{StaticResource RadiusControl}"
                                                    ToolTipService.ToolTip="从黑名单移除">
                                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControl}">
                                                    <FontIcon Glyph="&#xE738;" FontSize="{StaticResource FontSm}" VerticalAlignment="Center"
                                                              AutomationProperties.AccessibilityView="Raw"/>
                                                    <TextBlock Text="移除" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
