<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PcDemo.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:PcDemo.Models"
    NavigationCacheMode="Enabled">

    <Grid RowDefinitions="Auto,*" Padding="24">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="传输历史" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="收发文件完成后会自动记录在这里" FontSize="12" Opacity="0.6"/>
            </StackPanel>
            <Button Grid.Column="2" Content="清空" Click="OnClearClick" Padding="10,6" CornerRadius="8"
                    Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay}"/>
        </Grid>
        <ListView Grid.Row="1" Margin="0,12,0,0" ItemsSource="{x:Bind ViewModel.Items}" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="m:TransferHistoryItem">
                    <Border Margin="0,0,0,8" Padding="14,12" CornerRadius="12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10">
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}">
                                <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="16" Foreground="White"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind PeerText}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock FontSize="11.5" Opacity="0.65">
                                    <Run Text="{x:Bind FilesText}"/><Run Text=" · "/><Run Text="{x:Bind SizeText}"/>
                                    <Run Text=" · "/><Run Text="{x:Bind FirstFileName}" Foreground="Gray"/>
                                </TextBlock>
                            </StackPanel>
                            <Border Grid.Column="2" Padding="8,3" CornerRadius="9" VerticalAlignment="Center" Background="{x:Bind StatusBrush}">
                                <TextBlock Text="{x:Bind StatusText}" FontSize="11" Foreground="White"/>
                            </Border>
                            <TextBlock Grid.Column="3" Text="{x:Bind TimeText}" FontSize="11.5" Opacity="0.6" VerticalAlignment="Center"/>
                            <Button Grid.Column="4" Content="打开位置" Click="OnOpenFolderClick"
                                    Padding="8,4" CornerRadius="6" FontSize="11.5"
                                    VerticalAlignment="Center"
                                    Visibility="{x:Bind OpenFolderVisibility}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
            <FontIcon Glyph="&#xE81C;" FontSize="40" Opacity="0.35"/>
            <TextBlock Text="暂无传输记录" FontSize="14" Opacity="0.6" HorizontalAlignment="Center"/>
            <TextBlock Text="收发文件完成后会自动记录在这里" FontSize="11.5" Opacity="0.45" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Page>
