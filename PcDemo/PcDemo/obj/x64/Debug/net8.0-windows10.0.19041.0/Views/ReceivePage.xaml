<?xml version="1.0" encoding="utf-8"?>
<Page x:ConnectionId='1'
    x:Class="PcDemo.Views.ReceivePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:PcDemo.Converters">

    <Page.Resources>
        <converters:DeviceTypeToGlyphConverter x:Key="DeviceTypeGlyph"/>
        <converters:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
        <converters:RefreshingTextConverter x:Key="RefreshingTextConverter"/>
    </Page.Resources>

    <Grid Padding="24" RowDefinitions="Auto,Auto,Auto,*">

        <!-- 页面标题 -->
        <Grid Grid.Row="0" Margin="0,0,0,16" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="接收文件" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="等待附近设备发来文件" FontSize="12" Opacity="0.6"/>
            </StackPanel>
            <Border Grid.Column="1" Padding="14,6" CornerRadius="18" VerticalAlignment="Center"
                    Background="{ThemeResource AccentFillColorDefaultBrush}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse Width="8" Height="8" Fill="{ThemeResource TextOnAccentFillColorDefaultBrush}"/>
                    <TextBlock x:ConnectionId='14'                                                   FontSize="12"
                               Foreground="{ThemeResource TextOnAccentFillColorDefaultBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1" Padding="14,10" CornerRadius="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="🔌" FontSize="13" Opacity="0.7" VerticalAlignment="Center"/>
                    <TextBlock Opacity="0.8" FontSize="13">
                        <Run Text="端口 "/>
                        <Run x:ConnectionId='13'                                             FontWeight="SemiBold"/>
                    </TextBlock>
                </StackPanel>
                <Border Grid.Column="1" Margin="20,0,0,0" Padding="10,4" CornerRadius="10"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                    <TextBlock Text="HTTP · v2.2" FontSize="11" Opacity="0.7"/>
                </Border>
                <TextBlock x:ConnectionId='11' Grid.Column="2" Margin="16,0,0,0" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center"                                             />
                <TextBlock x:ConnectionId='12' Grid.Column="3"                                                   
                           Opacity="0.4" FontSize="11" IsTextSelectionEnabled="True"
                           VerticalAlignment="Center" TextAlignment="Right"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,12" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="附近设备" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Border Padding="8,2" CornerRadius="10" Background="{ThemeResource CardStrokeColorDefaultBrush}"
                        VerticalAlignment="Center">
                    <TextBlock x:ConnectionId='10'                                                      FontSize="11" Opacity="0.7"/>
                </Border>
            </StackPanel>
            <Button x:ConnectionId='7' Grid.Column="1"                                                   
                                                                                                                 
                    Padding="8" Background="Transparent" BorderThickness="0"
                    ToolTipService.ToolTip="重新搜索附近设备（每 20 秒自动刷新）">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ProgressRing x:ConnectionId='8' Width="14" Height="14"                                           />
                    <TextBlock x:ConnectionId='9'                                                                                            FontSize="12"/>
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="3">

            <ListView x:ConnectionId='4'                                          SelectionMode="None"
                                                                             >
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" ItemWidth="280" ItemHeight="120" MaximumRowsOrColumns="10"/>
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,10,10"/>
                        <Setter Property="MinHeight" Value="0"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="14" CornerRadius="12"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DeviceType, Converter={StaticResource DeviceTypeGlyph}}"
                                               FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Alias}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <TextBlock Text="🌐" FontSize="10" Opacity="0.7" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Ip}" Opacity="0.7" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="·" Opacity="0.5" FontSize="11"/>
                                        <TextBlock Text="{Binding Port}" Opacity="0.7" FontSize="11"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding DeviceModel}" Opacity="0.5" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4"
                                            VerticalAlignment="Top" Margin="0,2,0,0">
                                    <Ellipse Width="7" Height="7" Fill="#3FB668"/>
                                    <TextBlock Text="在线" FontSize="10" Opacity="0.6"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel x:ConnectionId='5' Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                             >
                <TextBlock Text="📡" FontSize="40" HorizontalAlignment="Center"/>
                <TextBlock Text="正在搜索附近设备..." FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="确保手机与电脑连接同一 Wi-Fi 网络" FontSize="12" Opacity="0.6" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <InfoBar x:ConnectionId='2' Grid.RowSpan="4"
                                                                            
                                                                          
                                                                              
                                                                                
                 IsClosable="True"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Top">
            <InfoBar.ActionButton>
                <Button x:ConnectionId='3' Content="打开文件夹"                           CornerRadius="6"
                                                                                  />
            </InfoBar.ActionButton>
        </InfoBar>
    </Grid>
</Page>

