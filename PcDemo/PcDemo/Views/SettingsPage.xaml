<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PcDemo.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    NavigationCacheMode="Enabled"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:PcDemo.Converters">

    <Page.Resources>
        <c:FirewallLevelToGlyphConverter x:Key="FirewallGlyph"/>
        <c:FirewallLevelToBrushConverter x:Key="FirewallBrush"/>
    </Page.Resources>

    <ScrollViewer Padding="{StaticResource SpacePage}" HorizontalScrollBarVisibility="Disabled">
        <!-- 不设 MaxWidth / HorizontalAlignment：ScrollViewer 内限宽 + 左对齐会让含星号列的
             子元素测量宽度与排布宽度不一致，WinUI 会反复重排（布局循环），页面表现即"卡死" -->
        <StackPanel Spacing="{StaticResource GapSection}">

            <!-- 页面标题 -->
            <StackPanel Spacing="{StaticResource GapMicro}" Margin="0,0,0,8">
                <TextBlock Text="设置" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="调整快传的传输参数和外观偏好" Style="{StaticResource PageSubtitleStyle}"/>
            </StackPanel>

            <!-- 设备身份 -->
            <Border Padding="{StaticResource SpaceCard}" CornerRadius="{StaticResource RadiusCard}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="{StaticResource GapBlock}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControl}">
                        <FontIcon Glyph="&#xE77B;" FontSize="{StaticResource FontH2}" VerticalAlignment="Center"
                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                  AutomationProperties.AccessibilityView="Raw"/>
                        <TextBlock Text="设备身份" FontSize="{StaticResource FontH2}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="132,*,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="本机显示名" VerticalAlignment="Center" Foreground="{ThemeResource BrandTextDimBrush}"/>
                        <StackPanel Grid.Column="1" Spacing="{StaticResource GapMicro}">
                            <TextBox Text="{x:Bind ViewModel.Alias, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="手机端 App 上看到的你的设备名"/>
                            <TextBlock Text="默认主机名；发送/接收时对方会看到这个名字。" Foreground="{ThemeResource BrandTextMuteBrush}" FontSize="{StaticResource FontSm}"/>
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="132,*,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="设备模型" VerticalAlignment="Center" Foreground="{ThemeResource BrandTextDimBrush}"/>
                        <TextBox Grid.Column="1" Text="{x:Bind ViewModel.DeviceModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                    <Grid ColumnDefinitions="132,*,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="设备类型" VerticalAlignment="Center" Foreground="{ThemeResource BrandTextDimBrush}"/>
                        <ComboBox Grid.Column="1" ItemsSource="{x:Bind DeviceTypeOptions, Mode=OneTime}"
                                  SelectedItem="{x:Bind ViewModel.DeviceType, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"/>
                    </Grid>
                    <Grid ColumnDefinitions="132,*,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="设备指纹" VerticalAlignment="Center" Foreground="{ThemeResource BrandTextDimBrush}"/>
                        <TextBox Grid.Column="1" Text="{x:Bind ViewModel.Fingerprint, Mode=OneWay}"
                                 IsReadOnly="True" Opacity="0.6"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 连接参数 -->
            <Border Padding="{StaticResource SpaceCard}" CornerRadius="{StaticResource RadiusCard}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="{StaticResource GapBlock}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControl}">
                        <FontIcon Glyph="&#xE72E;" FontSize="{StaticResource FontH2}" VerticalAlignment="Center"
                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                  AutomationProperties.AccessibilityView="Raw"/>
                        <TextBlock Text="连接与安全" FontSize="{StaticResource FontH2}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="132,*,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="服务端口" VerticalAlignment="Center" Foreground="{ThemeResource BrandTextDimBrush}"/>
                        <NumberBox Grid.Column="1" Value="{x:Bind ViewModel.Port, Mode=TwoWay}"
                                   Minimum="1" Maximum="65535" SpinButtonPlacementMode="Compact"
                                   HorizontalAlignment="Stretch"/>
                    </Grid>
                    <Grid ColumnDefinitions="132,*,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="多播组" VerticalAlignment="Center" Foreground="{ThemeResource BrandTextDimBrush}"/>
                        <TextBox Grid.Column="1" Text="{x:Bind ViewModel.MulticastGroup, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                    <Grid ColumnDefinitions="132,*,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="接收保存目录" VerticalAlignment="Center" Foreground="{ThemeResource BrandTextDimBrush}"/>
                        <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Text="{x:Bind ViewModel.Destination, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="1" Click="OnBrowseDestinationClick" Margin="8,0,0,0"
                                    Padding="{StaticResource SpaceRow}" CornerRadius="{StaticResource RadiusControl}"
                                    ToolTipService.ToolTip="选择文件保存目录">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControl}">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="{StaticResource FontBody}" VerticalAlignment="Center"
                                              AutomationProperties.AccessibilityView="Raw"/>
                                    <TextBlock Text="浏览…" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                    <Grid ColumnDefinitions="132,*,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="接收 PIN 码" VerticalAlignment="Center" Foreground="{ThemeResource BrandTextDimBrush}"/>
                        <Grid Grid.Column="1" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                            <PasswordBox x:Name="PinPasswordBox" Grid.Column="0" Height="32"
                                         PlaceholderText="留空 = 不启用，任何设备都可直接发送"
                                         PasswordChanged="OnPinPasswordChanged"/>
                            <TextBox x:Name="PinVisibleBox" Grid.Column="0" Height="32" Visibility="Collapsed"
                                     TextChanged="OnPinTextChanged"/>
                            <Button Grid.Column="1" x:Name="PinToggleBtn" Width="36" Height="32"
                                    Padding="{StaticResource SpaceZero}" Margin="8,0,0,0" Click="OnPinToggleClick"
                                    ToolTipService.ToolTip="显示/隐藏">
                                <FontIcon Glyph="&#xE8D4;" FontSize="{StaticResource FontH2}"/>
                            </Button>
                        </Grid>
                    </Grid>
                    <Grid ColumnDefinitions="132,*,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="使用 HTTPS" VerticalAlignment="Center" Foreground="{ThemeResource BrandTextDimBrush}"
                                   ToolTipService.ToolTip="开启后在 服务端口(默认 53317) 以 TLS 加密提供传输并公告 https（明文 HTTP 关闭，同端口不共存）。与支持 https 的设备互传时加密。保存后即时生效。"/>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.HttpsEnabled, Mode=TwoWay}"
                                      OnContent="开" OffContent="关" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="132,*,Auto" VerticalAlignment="Center">
                        <StackPanel Grid.Column="0" Spacing="{StaticResource GapMicro}" VerticalAlignment="Center">
                            <TextBlock Text="仅白名单模式" VerticalAlignment="Center" Foreground="{ThemeResource BrandTextDimBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="{StaticResource GapMicro}">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.WhitelistOnlyEnabled, Mode=TwoWay}"
                                          OnContent="开" OffContent="关" VerticalAlignment="Center"
                                          ToolTipService.ToolTip="开启后只接收白名单设备发来的文件，且发送页仅可选择白名单设备。即时生效，无需保存。"/>
                            <TextBlock Text="开启后非白名单设备将被置灰且无法收发。" Foreground="{ThemeResource BrandTextMuteBrush}" FontSize="{StaticResource FontSm}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 系统 -->
            <Border Padding="{StaticResource SpaceCard}" CornerRadius="{StaticResource RadiusCard}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="{StaticResource GapBlock}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControl}">
                        <FontIcon Glyph="&#xE770;" FontSize="{StaticResource FontH2}" VerticalAlignment="Center"
                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                  AutomationProperties.AccessibilityView="Raw"/>
                        <TextBlock Text="系统" FontSize="{StaticResource FontH2}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="132,*,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="开机自启" VerticalAlignment="Center" Foreground="{ThemeResource BrandTextDimBrush}"/>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.AutoLaunchEnabled, Mode=TwoWay}"
                                      OnContent="开" OffContent="关" VerticalAlignment="Center"
                                      ToolTipService.ToolTip="{x:Bind ViewModel.AutoLaunchInfo, Mode=OneWay}"/>
                    </Grid>
                    <Grid ColumnDefinitions="132,*,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="自动接收" VerticalAlignment="Center" Foreground="{ThemeResource BrandTextDimBrush}"
                                   ToolTipService.ToolTip="开启后所有设备的传输请求都跳过确认弹窗，直接保存（白名单条目可单独覆盖）。"/>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.AutoAcceptEnabled, Mode=TwoWay}"
                                      OnContent="开" OffContent="关" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 网络与防火墙 -->
            <Border Padding="{StaticResource SpaceCard}" CornerRadius="{StaticResource RadiusCard}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="{StaticResource GapBlock}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControl}">
                        <FontIcon Glyph="&#xE701;" FontSize="{StaticResource FontH2}" VerticalAlignment="Center"
                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                  AutomationProperties.AccessibilityView="Raw"/>
                        <TextBlock Text="网络与防火墙" FontSize="{StaticResource FontH2}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock FontSize="{StaticResource FontSm}" Foreground="{ThemeResource BrandTextDimBrush}" TextWrapping="Wrap"
                               Text="手机收不到公告或连不上本机时，最常见原因是 Windows 防火墙拦截了入站端口。可在此检测并添加放行规则。"/>

                    <!-- 状态条：图标 + 文本按检测结果着色（成功/警告/错误语义色）。
                         用 TextTrimming 而非 TextWrapping：星号列内放自动换行文本会随测量宽度反复改变高度，
                         是 WinUI 布局不收敛的常见诱因；过长文本用 ToolTip 兜底。 -->
                    <Border Padding="{StaticResource SpaceRow}" CornerRadius="{StaticResource RadiusControl}"
                            Background="{ThemeResource ChipFillBrush}">
                        <Grid ColumnDefinitions="Auto,*">
                            <FontIcon Grid.Column="0" FontSize="{StaticResource FontH2}" VerticalAlignment="Center" Margin="0,0,8,0"
                                      Glyph="{x:Bind ViewModel.FirewallLevel, Mode=OneWay, Converter={StaticResource FirewallGlyph}}"
                                      Foreground="{x:Bind ViewModel.FirewallLevel, Mode=OneWay, Converter={StaticResource FirewallBrush}}"
                                      AutomationProperties.AccessibilityView="Raw"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.FirewallStatus, Mode=OneWay}"
                                       FontSize="{StaticResource FontBody}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.FirewallStatus, Mode=OneWay}"
                                       Foreground="{x:Bind ViewModel.FirewallLevel, Mode=OneWay, Converter={StaticResource FirewallBrush}}"/>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControl}">
                        <Button Command="{x:Bind ViewModel.CheckFirewallCommand}"
                                Padding="{StaticResource SpaceRow}" CornerRadius="{StaticResource RadiusControl}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControl}">
                                <FontIcon Glyph="&#xE72C;" FontSize="{StaticResource FontBody}" VerticalAlignment="Center"
                                          AutomationProperties.AccessibilityView="Raw"/>
                                <TextBlock Text="重新检测" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{x:Bind ViewModel.AllowFirewallCommand}"
                                Padding="{StaticResource SpaceRow}" CornerRadius="{StaticResource RadiusControl}"
                                ToolTipService.ToolTip="需要管理员权限，会弹出 UAC 授权窗口">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControl}">
                                <FontIcon Glyph="&#xE785;" FontSize="{StaticResource FontBody}" VerticalAlignment="Center"
                                          AutomationProperties.AccessibilityView="Raw"/>
                                <TextBlock Text="添加放行规则" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 外观 -->
            <Border Padding="{StaticResource SpaceCard}" CornerRadius="{StaticResource RadiusCard}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="{StaticResource GapBlock}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapControl}">
                        <FontIcon Glyph="&#xE790;" FontSize="{StaticResource FontH2}" VerticalAlignment="Center"
                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                  AutomationProperties.AccessibilityView="Raw"/>
                        <TextBlock Text="外观" FontSize="{StaticResource FontH2}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="132,*,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="主题模式" VerticalAlignment="Center" Foreground="{ThemeResource BrandTextDimBrush}"/>
                        <StackPanel Grid.Column="1" Spacing="{StaticResource GapMicro}">
                            <RadioButtons SelectedIndex="{x:Bind ViewModel.ThemeMode, Mode=TwoWay}" MaxColumns="3">
                                <RadioButton Content="跟随系统"/>
                                <RadioButton Content="浅色"/>
                                <RadioButton Content="深色"/>
                            </RadioButtons>
                            <TextBlock Text="保存后立即切换；下次启动保留偏好。" Foreground="{ThemeResource BrandTextMuteBrush}" FontSize="{StaticResource FontSm}"/>
                        </StackPanel>
                    </Grid>
                    <Border Padding="{StaticResource SpaceRow}" CornerRadius="{StaticResource RadiusControl}"
                            Background="{ThemeResource ChipFillBrush}">
                        <TextBlock Text="窗口材质与动画强弱跟随系统设置（省电模式 / 减少透明 / 减少动画），应用内不提供开关。"
                                   FontSize="{StaticResource FontSm}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource BrandTextDimBrush}"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 操作栏：与上方卡片用一条细分隔线拉开 -->
            <Border Margin="0,4,0,0" Padding="0,12,0,0"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.SaveStatus, Mode=OneWay}"
                               VerticalAlignment="Center" Foreground="{ThemeResource BrandTextDimBrush}" TextTrimming="CharacterEllipsis"
                               Margin="0,0,12,0"/>
                    <Button Grid.Column="1" Content="保存更改"
                            Background="{ThemeResource BrandAccentFillBrush}"
                            Foreground="{ThemeResource TextOnAccentFillColorDefaultBrush}"
                            Padding="24,8" CornerRadius="{StaticResource RadiusControl}"
                            Command="{x:Bind ViewModel.SaveCommand}"/>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
