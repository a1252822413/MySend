<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PcDemo.Views.DeviceListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:PcDemo.Models"
    Background="Transparent">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16">

            <!-- 页面标题 -->
            <StackPanel Spacing="2" Margin="0,0,0,8">
                <TextBlock Text="设备管理" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="管理白名单与黑名单；白名单设备可单独开启自动接收" FontSize="12" Opacity="0.6"/>
            </StackPanel>

            <!-- 添加设备（共用） -->
            <Border Padding="18,14" CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="添加设备" FontSize="14" FontWeight="SemiBold" Opacity="0.85"/>

                    <!-- 从已发现设备选 -->
                    <Grid ColumnDefinitions="160,*,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="已发现设备" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" ItemsSource="{x:Bind ViewModel.DiscoveredDevices, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedDiscovered, Mode=TwoWay}"
                                  DisplayMemberPath="Alias"
                                  PlaceholderText="点击刷新或选择设备" HorizontalAlignment="Stretch"/>
                        <Button Grid.Column="2" Content="刷新" Click="OnRefreshDiscoveredClick" Margin="8,0,0,0"/>
                    </Grid>
                    <Grid ColumnDefinitions="160,Auto,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="加入" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="→ 白名单" Click="OnAddWhitelistFromDiscoveredClick"
                                Padding="12,6" CornerRadius="8" Margin="0,0,8,0"/>
                        <Button Grid.Column="2" Content="→ 黑名单" Click="OnAddBlacklistFromDiscoveredClick"
                                Padding="12,6" CornerRadius="8"/>
                    </Grid>

                    <!-- 手动输入（离线设备） -->
                    <Grid ColumnDefinitions="160,*,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="设备指纹" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{x:Bind ViewModel.NewFingerprint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="粘贴对方 fingerprint"/>
                    </Grid>
                    <Grid ColumnDefinitions="160,*,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="别名（可选）" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{x:Bind ViewModel.NewAlias, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="便于识别的名字"/>
                    </Grid>
                    <Grid ColumnDefinitions="160,Auto,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="加入" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="→ 白名单" Click="OnAddWhitelistManualClick"
                                Padding="12,6" CornerRadius="8" Margin="0,0,8,0"/>
                        <Button Grid.Column="2" Content="→ 黑名单" Click="OnAddBlacklistManualClick"
                                Padding="12,6" CornerRadius="8"/>
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Opacity="0.7" FontSize="12"/>
                </StackPanel>
            </Border>

            <!-- 白名单 -->
            <Border Padding="18,14" CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="10">
                    <TextBlock Text="白名单" FontSize="14" FontWeight="SemiBold" Opacity="0.85"/>
                    <TextBlock Text="白名单设备不会被自动拒绝；勾选「自动接收」可跳过确认弹窗直接保存文件。" Opacity="0.6" FontSize="12"/>

                    <ListView ItemsSource="{x:Bind ViewModel.Whitelist, Mode=OneWay}"
                              SelectionMode="None" HorizontalContentAlignment="Stretch">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="MinHeight" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:DeviceListEntry">
                                <Border Padding="14" CornerRadius="8"
                                        Background="{ThemeResource SubtleFillColorTransparentBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Grid ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{x:Bind Alias, Mode=OneWay}" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="{x:Bind Fingerprint, Mode=OneWay}" Opacity="0.5" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" Header="自动接收" OffContent="关" OnContent="开"
                                                      IsOn="{x:Bind AutoAccept, Mode=OneWay}"
                                                      Toggled="OnWhitelistAutoAcceptToggled"
                                                      DataContext="{x:Bind}"/>
                                        <Button Grid.Column="2" Content="移除" Margin="12,0,0,0"
                                                Click="OnRemoveWhitelistClick"
                                                DataContext="{x:Bind}"
                                                Padding="12,6" CornerRadius="8"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- 黑名单 -->
            <Border Padding="18,14" CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="10">
                    <TextBlock Text="黑名单" FontSize="14" FontWeight="SemiBold" Opacity="0.85"/>
                    <TextBlock Text="黑名单设备的文件请求会在 HTTP 层直接拒绝（403 Blocked by blacklist）。" Opacity="0.6" FontSize="12"/>

                    <ListView ItemsSource="{x:Bind ViewModel.Blacklist, Mode=OneWay}"
                              SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="MinHeight" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:DeviceListEntry">
                                <Border Padding="14" CornerRadius="8"
                                        Background="{ThemeResource SubtleFillColorTransparentBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{x:Bind Alias, Mode=OneWay}" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="{x:Bind Fingerprint, Mode=OneWay}" Opacity="0.5" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="移除" Margin="12,0,0,0"
                                                Click="OnRemoveBlacklistClick"
                                                DataContext="{x:Bind}"
                                                Padding="12,6" CornerRadius="8"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
