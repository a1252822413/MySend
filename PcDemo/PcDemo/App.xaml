<?xml version="1.0" encoding="utf-8"?>
<!--
  快传 · 应用级资源（唯一入口）
  视觉值全部来自 Styles/DesignTokens.xaml（design/unified/tokens.json 的 WinUI 3 落地件）。
  这里不再内联任何颜色/尺寸覆盖，避免 App.Resources 的直接资源抢先于合并字典、
  导致「改了令牌但界面不变」的旧问题。

  合并顺序不可颠倒：XamlControlsResources 先提供 WinUI 原生控件模板与内置画刷，
  DesignTokens.xaml 后覆盖语义色（Accent / Card / Chip / 描边）与尺寸令牌。
-->
<Application
    x:Class="PcDemo.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Styles/DesignTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
