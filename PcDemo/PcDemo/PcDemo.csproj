<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>PcDemo</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <!-- 发布配置文件模板：VS 的「Package and Publish」向导会按平台在
         Properties\PublishProfiles\ 下生成 win-<Platform>.pubxml。
         项目里没有预置这些文件，若无条件写死 PublishProfile，MSBuild 会在
         Microsoft.NET.Publish.targets 的 PrepareForPublish 里报 NETSDK1198
         （找不到发布配置文件）。因此只在对应文件真实存在时才设置该属性。 -->
    <PublishProfile Condition="Exists('$(MSBuildProjectDirectory)\Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- 便携版（unpackaged）构建开关：发布时额外传
           WindowsPackageType=None / EnableMsixTooling=false / WindowsAppSDKSelfContained=true
         （见 docs/ 或 build 说明里的完整命令）即可产出普通 exe 目录、不生成 MSIX。
         WindowsAppSDK 运行库一并带上，目标机无需预装 Windows App Runtime。
         代码侧已按 PathHelper.IsPackaged 自动切换数据目录与开机自启实现。 -->
    <WindowsAppSDKSelfContained Condition="'$(WindowsPackageType)' == 'None'">true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- GC 优化：关闭 Server GC（ASP.NET Core 默认开启，为高吞吐服务端优化，
         桌面应用改用 Workstation GC 可省 10-20MB 基线内存）。
         ConcurrentGarbageCollection=true 让 GC 在后台线程并发标记，不阻塞 UI。 -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <!-- WindowsAppSDK 1.8.260804001（2026/08，VS 18 兼容版本） -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260804001" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- 引入 ASP.NET Core 运行时（Kestrel / System.Text.Json），用于 LocalSend HTTP 服务 -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix"/>
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <!-- 不要开裁剪：WinUI 3 的 XAML 绑定 / WinRT 互操作大量走反射，trimmer 会把绑定目标
         当"未使用"裁掉，症状是 Release 包启动即崩（0xc000027b）或按钮点了没反应，
         而且不报任何编译错误。参见 microsoft-ui-xaml#9675 / #9740。 -->
    <PublishTrimmed>False</PublishTrimmed>
  </PropertyGroup>
</Project>