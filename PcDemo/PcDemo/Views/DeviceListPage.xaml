<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PcDemo.Views.DeviceListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    NavigationCacheMode="Enabled"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:PcDemo.Models"
    xmlns:c="using:PcDemo.Converters"
    Background="Transparent">

    <Page.Resources>
        <c:EmptyToCollapsed x:Key="EmptyToCollapsed"/>
        <c:DeviceTypeToGlyphConverter x:Key="DeviceTypeGlyph"/>
    </Page.Resources>

    <ScrollViewer Padding="24" HorizontalScrollBarVisibility="Disabled">
        <!-- 同 SettingsPage：ScrollViewer 内不可用 MaxWidth + HorizontalAlignment=Left
             （星号列测量/排布宽度不一致会触发布局循环） -->
        <StackPanel Spacing="16">

            <!-- 页面标题 -->
            <StackPanel Spacing="4" Margin="0,0,0,8">
                <TextBlock Text="设备管理" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="管理白名单与黑名单；白名单设备可单独开启自动接收" FontSize="12" Opacity="0.6"/>
            </StackPanel>

            <!-- 添加设备（共用） -->
            <Border Padding="16" CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" VerticalAlignment="Center"
                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                  AutomationProperties.AccessibilityView="Raw"/>
                        <TextBlock Text="添加设备" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 从已发现设备选 -->
                    <Grid ColumnDefinitions="160,*,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="已发现设备" VerticalAlignment="Center" Opacity="0.85"/>
                        <ComboBox Grid.Column="1" ItemsSource="{x:Bind ViewModel.DiscoveredDevices, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedDiscovered, Mode=TwoWay}"
                                  DisplayMemberPath="Alias"
                                  PlaceholderText="点击刷新或选择设备" HorizontalAlignment="Stretch"/>
                        <Button Grid.Column="2" Click="OnRefreshDiscoveredClick" Margin="8,0,0,0"
                                Padding="12,8" CornerRadius="8" ToolTipService.ToolTip="重新读取附近设备列表">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72C;" FontSize="13" VerticalAlignment="Center"
                                          AutomationProperties.AccessibilityView="Raw"/>
                                <TextBlock Text="刷新" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Grid ColumnDefinitions="160,Auto,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="加入" VerticalAlignment="Center" Opacity="0.85"/>
                        <Button Grid.Column="1" Click="OnAddWhitelistFromDiscoveredClick"
                                Padding="12,8" CornerRadius="8" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE73E;" FontSize="13" VerticalAlignment="Center"
                                          AutomationProperties.AccessibilityView="Raw"/>
                                <TextBlock Text="白名单" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Click="OnAddBlacklistFromDiscoveredClick"
                                Padding="12,8" CornerRadius="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8F8;" FontSize="13" VerticalAlignment="Center"
                                          AutomationProperties.AccessibilityView="Raw"/>
                                <TextBlock Text="黑名单" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- 手动输入（离线设备） -->
                    <Grid ColumnDefinitions="160,*,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="设备指纹" VerticalAlignment="Center" Opacity="0.85"/>
                        <TextBox Grid.Column="1" Text="{x:Bind ViewModel.NewFingerprint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="粘贴对方 fingerprint"/>
                    </Grid>
                    <Grid ColumnDefinitions="160,*,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="别名（可选）" VerticalAlignment="Center" Opacity="0.85"/>
                        <TextBox Grid.Column="1" Text="{x:Bind ViewModel.NewAlias, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="便于识别的名字"/>
                    </Grid>
                    <Grid ColumnDefinitions="160,Auto,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="加入" VerticalAlignment="Center" Opacity="0.85"/>
                        <Button Grid.Column="1" Click="OnAddWhitelistManualClick"
                                Padding="12,8" CornerRadius="8" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE73E;" FontSize="13" VerticalAlignment="Center"
                                          AutomationProperties.AccessibilityView="Raw"/>
                                <TextBlock Text="白名单" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Click="OnAddBlacklistManualClick"
                                Padding="12,8" CornerRadius="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8F8;" FontSize="13" VerticalAlignment="Center"
                                          AutomationProperties.AccessibilityView="Raw"/>
                                <TextBlock Text="黑名单" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- 操作结果提示：语义色状态条 -->
                    <Border Padding="12,8" CornerRadius="8"
                            Background="{ThemeResource ChipFillBrush}"
                            Visibility="{x:Bind ViewModel.StatusText, Mode=OneWay, Converter={StaticResource EmptyToCollapsed}}">
                        <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" FontSize="12" Opacity="0.85"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 白名单 -->
            <Border Padding="16" CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE73E;" FontSize="14" VerticalAlignment="Center"
                                  Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                  AutomationProperties.AccessibilityView="Raw"/>
                        <TextBlock Text="白名单" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="白名单设备不会被自动拒绝；勾选「自动接收」可跳过确认弹窗直接保存文件。" Opacity="0.6" FontSize="12"/>

                    <!-- 空态 -->
                    <Border Padding="24,16" CornerRadius="8"
                            Background="{ThemeResource SubtleFillColorTransparentBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            Visibility="{x:Bind ViewModel.HasNoWhitelist, Mode=OneWay}">
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE8FB;" FontSize="24" Opacity="0.4" HorizontalAlignment="Center"
                                      AutomationProperties.AccessibilityView="Raw"/>
                            <TextBlock Text="白名单为空" FontSize="13" Opacity="0.7" HorizontalAlignment="Center"/>
                            <TextBlock Text="从上方选择已发现设备，或粘贴指纹手动加入" FontSize="11.5" Opacity="0.5"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <ListView ItemsSource="{x:Bind ViewModel.Whitelist, Mode=OneWay}"
                              SelectionMode="None" HorizontalContentAlignment="Stretch">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="MinHeight" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:DeviceListEntry">
                                <Border Padding="12" CornerRadius="10"
                                        Background="{ThemeResource SubtleFillColorTransparentBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                        <!-- 设备类型头像瓦片 -->
                                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="12"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind DeviceType, Mode=OneWay, Converter={StaticResource DeviceTypeGlyph}}"
                                                       FontFamily="Segoe Fluent Icons" FontSize="16"
                                                       Foreground="{ThemeResource TextOnAccentFillColorDefaultBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       AutomationProperties.AccessibilityView="Raw"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Alias, Mode=OneWay}" FontWeight="SemiBold" FontSize="13"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{x:Bind Fingerprint, Mode=OneWay}" Opacity="0.5" FontSize="11"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="2" Header="自动接收" OffContent="关" OnContent="开"
                                                      IsOn="{x:Bind AutoAccept, Mode=OneWay}"
                                                      Toggled="OnWhitelistAutoAcceptToggled"
                                                      DataContext="{x:Bind}"/>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                                            <Button Click="OnRenameWhitelistClick"
                                                    DataContext="{x:Bind}" Padding="8" CornerRadius="8"
                                                    ToolTipService.ToolTip="修改本地显示名称">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE70F;" FontSize="12" VerticalAlignment="Center"
                                                              AutomationProperties.AccessibilityView="Raw"/>
                                                    <TextBlock Text="重命名" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Click="OnRemoveWhitelistClick"
                                                    DataContext="{x:Bind}" Padding="8" CornerRadius="8"
                                                    ToolTipService.ToolTip="从白名单移除">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE738;" FontSize="12" VerticalAlignment="Center"
                                                              AutomationProperties.AccessibilityView="Raw"/>
                                                    <TextBlock Text="移除" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- 黑名单 -->
            <Border Padding="16" CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8F8;" FontSize="14" VerticalAlignment="Center"
                                  Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                  AutomationProperties.AccessibilityView="Raw"/>
                        <TextBlock Text="黑名单" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="黑名单设备的文件请求会在 HTTP 层直接拒绝（403 Blocked by blacklist）。" Opacity="0.6" FontSize="12"/>

                    <!-- 空态 -->
                    <Border Padding="24,16" CornerRadius="8"
                            Background="{ThemeResource SubtleFillColorTransparentBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            Visibility="{x:Bind ViewModel.HasNoBlacklist, Mode=OneWay}">
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE8F8;" FontSize="24" Opacity="0.4" HorizontalAlignment="Center"
                                      AutomationProperties.AccessibilityView="Raw"/>
                            <TextBlock Text="黑名单为空" FontSize="13" Opacity="0.7" HorizontalAlignment="Center"/>
                            <TextBlock Text="被拉黑的设备将无法向本机发送任何文件" FontSize="11.5" Opacity="0.5"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <ListView ItemsSource="{x:Bind ViewModel.Blacklist, Mode=OneWay}"
                              SelectionMode="None" HorizontalContentAlignment="Stretch">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="MinHeight" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:DeviceListEntry">
                                <Border Padding="12" CornerRadius="10"
                                        Background="{ThemeResource SubtleFillColorTransparentBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="12"
                                                Background="{ThemeResource ChipFillBrush}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind DeviceType, Mode=OneWay, Converter={StaticResource DeviceTypeGlyph}}"
                                                       FontFamily="Segoe Fluent Icons" FontSize="16" Opacity="0.75"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       AutomationProperties.AccessibilityView="Raw"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Alias, Mode=OneWay}" FontWeight="SemiBold" FontSize="13"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{x:Bind Fingerprint, Mode=OneWay}" Opacity="0.5" FontSize="11"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                            <Button Click="OnRenameBlacklistClick"
                                                    DataContext="{x:Bind}" Padding="8" CornerRadius="8"
                                                    ToolTipService.ToolTip="修改本地显示名称">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE70F;" FontSize="12" VerticalAlignment="Center"
                                                              AutomationProperties.AccessibilityView="Raw"/>
                                                    <TextBlock Text="重命名" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Click="OnRemoveBlacklistClick"
                                                    DataContext="{x:Bind}" Padding="8" CornerRadius="8"
                                                    ToolTipService.ToolTip="从黑名单移除">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE738;" FontSize="12" VerticalAlignment="Center"
                                                              AutomationProperties.AccessibilityView="Raw"/>
                                                    <TextBlock Text="移除" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
