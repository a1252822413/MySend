<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PcDemo.Views.SendPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PcDemo.ViewModels"
    xmlns:c="using:PcDemo.Converters"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
    Background="Transparent"
    AllowDrop="True"
    DragOver="OnDragOver"
    DragLeave="OnDragLeave"
    Drop="OnDrop">
    <Page.Resources>
        <c:FileKindToGlyphConverter x:Key="FileKindGlyph"/>
        <c:NullToCollapsed x:Key="NullToCollapsed"/>
        <c:BytesToString x:Key="BytesToString"/>
        <c:DoubleToPercent x:Key="DoubleToPercent"/>
        <c:DoubleToPercentText x:Key="DoubleToPercentText"/>
        <c:FailedToVisible x:Key="FailedToVisible"/>
        <c:PendingOnlyToVisible x:Key="PendingOnlyToVisible"/>
        <c:SendFileStatusToColor x:Key="StatusColor"/>
        <c:SendFileStatusToProgressColor x:Key="ProgressColor"/>
        <c:ShowProgressBarWhenInProgressOrDone x:Key="ShowProgress"/>
        <c:BoolToPassColor x:Key="BoolToPassColor"/>
        <c:BoolToHintColor x:Key="BoolToHintColor"/>
        <c:BoolToReadyTarget x:Key="BoolToReadyTarget"/>
        <c:BoolToReadyFile x:Key="BoolToReadyFile"/>
        <c:BoolToReadyState x:Key="BoolToReadyState"/>
        <c:BoolToOnlineDot x:Key="BoolToOnlineDot"/>
        <c:BoolToOnlineLabel x:Key="BoolToOnlineLabel"/>
        <c:DeviceTypeToGlyphConverter x:Key="DeviceTypeGlyph"/>
        <c:SendSessionStateToText x:Key="StateText"/>
        <c:BoolToSelectionBrush x:Key="PickBrush"/>
        <c:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
        <c:RefreshingTextConverter x:Key="RefreshingTextConverter"/>
    </Page.Resources>

    <Grid Padding="24" RowDefinitions="Auto,Auto,*" Background="Transparent"
          AllowDrop="True" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">
        <Border x:Name="DropHighlightBorder" Margin="0" CornerRadius="14"
                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                BorderThickness="2" Background="{ThemeResource AccentFillColorDefaultBrush}"
                Opacity="0" IsHitTestVisible="False"/>

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="发送文件" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="选择目标设备和要发送的文件" FontSize="12" Opacity="0.6"/>
            </StackPanel>
        </Grid>

            <InfoBar
                Grid.Row="0"
                Grid.RowSpan="3"
                VerticalAlignment="Top"
                HorizontalAlignment="Stretch"
                IsOpen="{x:Bind ViewModel.IsNotificationOpen, Mode=OneWay}"
                Title="{x:Bind ViewModel.NotificationTitle, Mode=OneWay}"
                Message="{x:Bind ViewModel.NotificationMessage, Mode=OneWay}"
                Severity="{x:Bind ViewModel.NotificationSeverity, Mode=OneWay}"
                IsClosable="True"
                Margin="0,0,0,0"
                CornerRadius="8"/>

            <Grid Grid.Row="1" Margin="0,24,0,0" RowDefinitions="Auto,Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="选择目标设备" FontSize="16" FontWeight="SemiBold"/>
                        <Border Padding="8,2" CornerRadius="10" Background="{ThemeResource CardStrokeColorDefaultBrush}">
                            <TextBlock Text="{x:Bind ViewModel.Devices.Count, Mode=OneWay}" FontSize="11" Opacity="0.7"/>
                        </Border>
                    </StackPanel>
                    <Button Grid.Column="1" Command="{x:Bind ViewModel.RefreshDevicesCommand}"
                            IsEnabled="{x:Bind ViewModel.IsRefreshing, Converter={StaticResource InvertedBoolConverter}}"
                            Padding="8" Background="Transparent" BorderThickness="0"
                            ToolTipService.ToolTip="重新搜索（每 20 秒自动刷新）">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ProgressRing Width="14" Height="14" IsActive="{x:Bind ViewModel.IsRefreshing}"/>
                            <TextBlock Text="{x:Bind ViewModel.IsRefreshing, Converter={StaticResource RefreshingTextConverter}}" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Grid.Row="1" Margin="0,12,0,16" Padding="14,10" CornerRadius="10"
                        Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.9"
                        Visibility="{x:Bind ViewModel.SelectedTarget, Converter={StaticResource NullToCollapsed}}">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="🎯" FontSize="16"/>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind ViewModel.SelectedTarget.Alias, Mode=OneWay}"
                                           FontWeight="SemiBold" FontSize="13"/>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="🌐" FontSize="10" Opacity="0.8" VerticalAlignment="Center"/>
                                    <TextBlock FontSize="11" Opacity="0.85" VerticalAlignment="Center">
                                        <Run Text="{x:Bind ViewModel.SelectedTarget.Ip, Mode=OneWay}"/>
                                        <Run Text="·"/>
                                        <Run Text="{x:Bind ViewModel.SelectedTarget.Port, Mode=OneWay}"/>
                                        <Run Text="·"/>
                                        <Run Text="{x:Bind ViewModel.SelectedTarget.DeviceModel, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" Content="更换" Padding="10,4" FontSize="12"
                                Click="OnDeselectTargetClick" Background="Transparent"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                    </Grid>
                </Border>

                <ListView Grid.Row="2"
                          ItemsSource="{x:Bind ViewModel.Devices}"
                          SelectionMode="Single"
                          SelectedItem="{x:Bind ViewModel.SelectedTarget, Mode=TwoWay}"
                          Visibility="{x:Bind ViewModel.HasDevices, Mode=OneWay}">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal"
                                           ItemWidth="280" ItemHeight="120" MaximumRowsOrColumns="10"/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,10,10"/>
                            <Setter Property="MinHeight" Value="0"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="14" CornerRadius="12"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{Binding IsPicked, Mode=OneWay, Converter={StaticResource PickBrush}}"
                                    BorderThickness="1.5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DeviceType, Converter={StaticResource DeviceTypeGlyph}}"
                                                   FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Alias}" FontWeight="SemiBold" FontSize="14"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock Text="🌐" FontSize="10" Opacity="0.7" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Ip}" Opacity="0.7" FontSize="11"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="·" Opacity="0.5" FontSize="11"/>
                                            <TextBlock Text="{Binding Port}" Opacity="0.7" FontSize="11"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding DeviceModel}" Opacity="0.5" FontSize="11"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4"
                                                VerticalAlignment="Top" Margin="0,2,0,0">
                                        <Ellipse Width="7" Height="7"
                                                 Fill="{Binding IsOnline, Converter={StaticResource BoolToOnlineDot}}"/>
                                        <TextBlock Text="{Binding IsOnline, Converter={StaticResource BoolToOnlineLabel}}"
                                                   FontSize="10" Opacity="0.7"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Grid.Row="2" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.HasNoDevices, Mode=OneWay}">
                    <TextBlock Text="📡" FontSize="40" HorizontalAlignment="Center"/>
                    <TextBlock Text="正在搜索附近设备..." FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="确保目标设备开启 LocalSend 并连接同一 Wi-Fi"
                               FontSize="12" Opacity="0.6" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" Margin="0,28,0,0" RowDefinitions="Auto,Auto,*,Auto">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="待发送文件" FontSize="16" FontWeight="SemiBold"/>
                        <Border Padding="8,2" CornerRadius="10" Background="{ThemeResource CardStrokeColorDefaultBrush}">
                            <TextBlock Text="{x:Bind ViewModel.PendingFiles.Count, Mode=OneWay}" FontSize="11" Opacity="0.7"/>
                        </Border>
                    </StackPanel>
                    <Button Grid.Column="1" Content="📁 添加文件" Click="OnPickFilesClick"
                            Padding="14,7" CornerRadius="8" Margin="0,0,8,0"/>
                    <Button Grid.Column="2" Content="清空" Command="{x:Bind ViewModel.ClearFilesCommand}"
                            Padding="10,7" CornerRadius="8"
                            Visibility="{x:Bind ViewModel.HasFiles, Mode=OneWay}"/>
                </Grid>

                <Border Grid.Row="1" Margin="0,12,0,12" Padding="14,12" CornerRadius="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        Visibility="{x:Bind ViewModel.Current, Converter={StaticResource NullToCollapsed}}">
                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="📤" FontSize="16" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,0" Spacing="2">
                            <TextBlock FontSize="12">
                                <Run Text="→"/>
                                <Run Text=" "/>
                                <Run Text="{x:Bind ViewModel.Current.Target.Alias, Mode=OneWay}"/>
                                <Run Text="  ·  "/>
                                <Run Text="{x:Bind ViewModel.Current.CompletedFiles, Mode=OneWay}"/>
                                <Run Text=" / "/>
                                <Run Text="{x:Bind ViewModel.Current.Files.Count, Mode=OneWay}"/>
                                <Run Text=" 个文件"/>
                            </TextBlock>
                            <TextBlock FontSize="11" Opacity="0.6"
                                       Text="{x:Bind ViewModel.Current.State, Mode=OneWay, Converter={StaticResource StateText}}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock FontSize="12" Opacity="0.75" VerticalAlignment="Center">
                                <Run Text="{x:Bind c:ByteFormatter.Format(ViewModel.Current.TotalBytesSent), Mode=OneWay}"/>
                                <Run Text=" / "/>
                                <Run Text="{x:Bind c:ByteFormatter.Format(ViewModel.Current.TotalBytes), Mode=OneWay}"/>
                                <Run Text="  ·  "/>
                                <Run Text="{x:Bind ViewModel.Current.Progress, Mode=OneWay, Converter={StaticResource DoubleToPercentText}}"/>
                                <Run Text="%"/>
                                <Run Text="{x:Bind c:ByteFormatter.FormatSpeed(ViewModel.Current.SpeedBytesPerSecond), Mode=OneWay}"/>
                                <Run Text="{x:Bind c:ByteFormatter.FormatEta(ViewModel.Current.EtaSeconds), Mode=OneWay}"/>
                            </TextBlock>
                            <Button Content="取消" Command="{x:Bind ViewModel.CancelSendCommand}"
                                    Padding="10,4" CornerRadius="6" FontSize="12"/>
                        </StackPanel>
                        <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                     Value="{x:Bind ViewModel.Current.Progress, Mode=OneWay, Converter={StaticResource DoubleToPercent}}"
                                     Minimum="0" Maximum="100" Margin="0,10,0,0" Height="6" CornerRadius="3"/>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Margin="0,12,0,0" Padding="12,0" CornerRadius="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        MaxHeight="320">
                    <Grid>
                        <ListView ItemsSource="{x:Bind ViewModel.PendingFiles}" SelectionMode="None"
                                  Padding="0,0,8,0"
                                  Visibility="{x:Bind ViewModel.HasFiles, Mode=OneWay}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,3,0,3"/>
                                    <Setter Property="MinHeight" Value="48"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,8,12,8" CornerRadius="10"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <Grid ColumnDefinitions="Auto,40,*" VerticalAlignment="Center">
                                            <Border Grid.Column="0" Width="4" CornerRadius="2" MaxHeight="32"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding Status, Converter={StaticResource StatusColor}}"/>
                                            <Border Grid.Column="1" Width="40" Height="40" CornerRadius="10"
                                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0">
                                                <TextBlock Text="{Binding FileKind, Converter={StaticResource FileKindGlyph}}"
                                                           FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Grid Grid.Column="2" Margin="10,0,0,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding FileName}"
                                                               FontSize="13" FontWeight="SemiBold"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="1" FontSize="11" Opacity="0.6" VerticalAlignment="Center">
                                                        <Run Text="{Binding BytesSent, Mode=OneWay, Converter={StaticResource BytesToString}}"/>
                                                        <Run Text=" / "/>
                                                        <Run Text="{Binding Size, Mode=OneWay, Converter={StaticResource BytesToString}}"/>
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="2" FontSize="11" Opacity="0.65"
                                                               Text="{Binding Status}" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="3" FontSize="12" Padding="10,4" CornerRadius="6"
                                                            Content="移除" VerticalAlignment="Center" Margin="0,0,10,0"
                                                            ToolTipService.ToolTip="从列表移除"
                                                            Click="OnRemoveFileClick"
                                                            Visibility="{Binding Status, Converter={StaticResource PendingOnlyToVisible}}"/>
                                                </Grid>
                                                <ProgressBar Grid.Row="1" Margin="0,4,0,0" Height="4" CornerRadius="2"
                                                             Maximum="{Binding Size}"
                                                             Value="{Binding BytesSent, Mode=OneWay}"
                                                             Foreground="{Binding Status, Converter={StaticResource ProgressColor}}"
                                                             Visibility="{Binding Status, Converter={StaticResource ShowProgress}}"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0,24"
                                    Visibility="{x:Bind ViewModel.HasNoFiles, Mode=OneWay}">
                            <TextBlock Text="📄" FontSize="40" HorizontalAlignment="Center"/>
                            <TextBlock Text="还没有选择文件" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="点击上方“添加文件”选择要发送的文件" FontSize="12" Opacity="0.6" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="3" Margin="0,20,0,0" ColumnDefinitions="*,Auto">
                    <Grid Grid.Column="0" ColumnDefinitions="Auto,*">
                        <StackPanel Orientation="Vertical" Spacing="4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="10" Height="10"
                                         Fill="{x:Bind ViewModel.HasSelectedTarget, Mode=OneWay, Converter={StaticResource BoolToPassColor}}"/>
                                <TextBlock FontSize="11" VerticalAlignment="Center"
                                           Text="{x:Bind ViewModel.HasSelectedTarget, Mode=OneWay, Converter={StaticResource BoolToReadyTarget}}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="10" Height="10"
                                         Fill="{x:Bind ViewModel.HasPendingFiles, Mode=OneWay, Converter={StaticResource BoolToPassColor}}"/>
                                <TextBlock FontSize="11" VerticalAlignment="Center"
                                           Text="{x:Bind ViewModel.HasPendingFiles, Mode=OneWay, Converter={StaticResource BoolToReadyFile}}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="10" Height="10"
                                         Fill="{x:Bind ViewModel.IsIdleOrFinished, Mode=OneWay, Converter={StaticResource BoolToPassColor}}"/>
                                <TextBlock FontSize="11" VerticalAlignment="Center"
                                           Text="{x:Bind ViewModel.IsIdleOrFinished, Mode=OneWay, Converter={StaticResource BoolToReadyState}}"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   FontSize="12" Opacity="0.9" VerticalAlignment="Center"
                                   Margin="18,0,0,0"
                                   Foreground="{x:Bind ViewModel.CanSend, Mode=OneWay, Converter={StaticResource BoolToHintColor}}"
                                   Text="{x:Bind ViewModel.SendDisabledHint, Mode=OneWay}"/>
                    </Grid>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <TextBox PlaceholderText="PIN（对方启用时必填）"
                                 Text="{x:Bind ViewModel.Pin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Width="170" Padding="10,6" CornerRadius="8" VerticalAlignment="Center"/>
                        <Button Content="🚀 开始发送"
                                Command="{x:Bind ViewModel.StartSendCommand}"
                                Padding="20,10" CornerRadius="10"
                                FontSize="14" FontWeight="SemiBold"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
</Page>
