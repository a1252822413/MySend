<?xml version="1.0" encoding="utf-8"?>
<Page x:ConnectionId='1'
    x:Class="PcDemo.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:PcDemo.Models"
    NavigationCacheMode="Enabled">

    <Grid RowDefinitions="Auto,*" Padding="24">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="传输历史" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="收发文件完成后会自动记录在这里" FontSize="12" Opacity="0.6"/>
            </StackPanel>
            <Button x:ConnectionId='14' Grid.Column="2" Content="清空"                      Padding="10,6" CornerRadius="8"
                                                                         />
        </Grid>
        <ListView x:ConnectionId='2' Grid.Row="1" Margin="0,12,0,0"                                        SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate                                   >
                    <Border x:ConnectionId='5' Margin="0,0,0,8" Padding="14,12" CornerRadius="12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}">
                                <FontIcon x:ConnectionId='13'                            FontSize="16" Foreground="White"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:ConnectionId='9'                          FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock FontSize="11.5" Opacity="0.65">
                                    <Run x:ConnectionId='10'                          /><Run Text=" · "/><Run x:ConnectionId='11'                         />
                                    <Run Text=" · "/><Run x:ConnectionId='12'                               Foreground="Gray"/>
                                </TextBlock>
                            </StackPanel>
                            <Border x:ConnectionId='6' Grid.Column="2" Padding="8,3" CornerRadius="9" VerticalAlignment="Center"                                  >
                                <TextBlock x:ConnectionId='8'                            FontSize="11" Foreground="White"/>
                            </Border>
                            <TextBlock x:ConnectionId='7' Grid.Column="3"                          FontSize="11.5" Opacity="0.6" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <StackPanel x:ConnectionId='3' Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                                                                        >
            <FontIcon Glyph="&#xE81C;" FontSize="40" Opacity="0.35"/>
            <TextBlock Text="暂无传输记录" FontSize="14" Opacity="0.6" HorizontalAlignment="Center"/>
            <TextBlock Text="收发文件完成后会自动记录在这里" FontSize="11.5" Opacity="0.45" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Page>

