<?xml version="1.0" encoding="utf-8"?>
<!-- 发送进度对话框：单发=单环进度；群发=每台一行列表。
     取消需二次确认。PrimaryButton"取消传输" → 二次确认面板（不关闭对话框） -->
<ContentDialog
    x:Class="PcDemo.Views.SendProgressDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="正在发送"
    PrimaryButtonText="取消传输"
    PrimaryButtonClick="OnCancelClick"
    SecondaryButtonClick="OnContinueClick">

    <Grid MinWidth="480">
        <!-- 单发面板：单个设备 → 环形进度 -->
        <StackPanel x:Name="SinglePanel" Spacing="14" Padding="0,4,0,0">
            <TextBlock x:Name="TargetTextBlock" FontSize="14" Opacity="0.8"
                       HorizontalAlignment="Center"/>
            <ProgressRing x:Name="ProgressRingControl" Width="84" Height="84"/>
            <StackPanel Spacing="4" HorizontalAlignment="Center">
                <TextBlock x:Name="StateTextBlock" FontSize="15" FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="FilesTextBlock" FontSize="12" Opacity="0.7"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="StatTextBlock" FontSize="12" Opacity="0.75"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <!-- 群发面板：每台一行（设备名+状态+迷你进度条），顶部汇总 -->
        <StackPanel x:Name="BatchPanel" Visibility="Collapsed" Spacing="10" Padding="0,2,0,0">
            <TextBlock x:Name="BatchSummaryTextBlock" FontSize="13" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Opacity="0.9"/>
            <!-- MaxHeight 在 code-behind 按窗口高度动态适配（Opened 时），避免设备多时弹窗超出界面 -->
            <ScrollViewer x:Name="BatchListScroll" MaxHeight="330"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="BatchListPanel" Spacing="6"/>
            </ScrollViewer>
        </StackPanel>
    </Grid>
</ContentDialog>
