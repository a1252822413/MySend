<?xml version="1.0" encoding="utf-8"?>
<!--
  FileProgressRow：多文件进度清单的单行（design/unified v1.3 FileProgressList）。
  发送进度 / 接收进度 4 个弹窗共用；所有颜色都在 XAML 里用 ThemeResource，
  避免在 C# 里按主题字典取画刷（深浅主题切换时不可靠）。
  一行固定包含：状态图标位、文件名、大小、状态文字、一条独立进度条、字节明细。
  等待态显示空心描边轨道，保证 0% 在深色下也看得见。
-->
<UserControl
    x:Class="PcDemo.Controls.FileProgressRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <!-- 中性行底 + 当前文件高亮层（叠在内容之后，切换用 Visibility，不换画刷） -->
        <Border CornerRadius="{StaticResource RadiusRow}"
                Background="{ThemeResource BrandSurface2Brush}"/>
        <Border x:Name="ActiveLayer" CornerRadius="{StaticResource RadiusRow}"
                Background="{ThemeResource BrandAccentSoftBrush}"
                Visibility="Collapsed"/>
        <Border x:Name="ActiveEdge" Width="4" HorizontalAlignment="Left"
                CornerRadius="4,0,0,4" Visibility="Collapsed"
                Background="{ThemeResource BrandAccentBrush}"/>

        <Border Padding="12,8,12,8" BorderThickness="1"
                BorderBrush="{ThemeResource BrandLineBrush}">
            <StackPanel Spacing="{StaticResource GapMicro}">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="{StaticResource GapControl}">
                    <FontIcon x:Name="StateIcon" Grid.Column="0" Glyph="&#xE73E;"
                              FontSize="{StaticResource FontSm}"
                              Foreground="{ThemeResource BrandTextMuteBrush}"
                              VerticalAlignment="Center"
                              AutomationProperties.AccessibilityView="Raw"/>
                    <TextBlock x:Name="NameText" Grid.Column="1"
                               FontSize="{StaticResource FontBody}" FontWeight="SemiBold"
                               Foreground="{ThemeResource BrandTextBrush}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <TextBlock x:Name="SizeText" Grid.Column="2"
                               FontSize="{StaticResource FontLabel}"
                               Foreground="{ThemeResource BrandTextDimBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Grid.Column="3"
                               FontSize="{StaticResource FontLabel}"
                               Foreground="{ThemeResource BrandTextDimBrush}"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- 进度条轨道：正常 / 失败 / 等待三态叠层 -->
                <Grid Height="4">
                    <ProgressBar x:Name="Bar" Height="4" Minimum="0" Maximum="100" Value="0"
                                 CornerRadius="{StaticResource RadiusXs}"
                                 Foreground="{ThemeResource BrandAccentFillBrush}"
                                 Background="{ThemeResource BrandSurface3Brush}"/>
                    <ProgressBar x:Name="BarDanger" Height="4" Minimum="0" Maximum="100" Value="0"
                                 Visibility="Collapsed" CornerRadius="{StaticResource RadiusXs}"
                                 Foreground="{ThemeResource BrandDangerBrush}"
                                 Background="{ThemeResource BrandSurface3Brush}"/>
                    <Border x:Name="WaitTrack" Height="4" Visibility="Collapsed"
                            CornerRadius="{StaticResource RadiusXs}"
                            BorderThickness="1" BorderBrush="{ThemeResource BrandLineStrongBrush}"
                            Background="Transparent"/>
                </Grid>

                <TextBlock x:Name="DetailText" FontSize="{StaticResource FontLabel}"
                           Foreground="{ThemeResource BrandTextDimBrush}" Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
