<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PcDemo.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16">

            <!-- 页面标题 -->
            <StackPanel Spacing="2" Margin="0,0,0,8">
                <TextBlock Text="设置" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="调整 LocalSend PC 的传输参数和外观偏好" FontSize="12" Opacity="0.6"/>
            </StackPanel>

            <!-- 设备身份 -->
            <Border Padding="18,14" CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="14">
                    <TextBlock Text="设备身份" FontSize="14" FontWeight="SemiBold" Opacity="0.85"/>
                    <Grid ColumnDefinitions="160,*,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="本机显示名" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBox Text="{x:Bind ViewModel.Alias, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="手机端 App 上看到的你的设备名"/>
                            <TextBlock Text="默认主机名；发送/接收时对方会看到这个名字。" Opacity="0.6" FontSize="12"/>
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="160,*,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="设备模型" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{x:Bind ViewModel.DeviceModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                    <Grid ColumnDefinitions="160,*,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="设备类型" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" ItemsSource="{x:Bind DeviceTypeOptions, Mode=OneTime}"
                                  SelectedItem="{x:Bind ViewModel.DeviceType, Mode=TwoWay}"/>
                    </Grid>
                    <Grid ColumnDefinitions="160,*,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="设备指纹" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{x:Bind ViewModel.Fingerprint, Mode=OneWay}"
                                 IsReadOnly="True" Opacity="0.6"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 连接参数 -->
            <Border Padding="18,14" CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="14">
                    <TextBlock Text="连接参数" FontSize="14" FontWeight="SemiBold" Opacity="0.85"/>
                    <Grid ColumnDefinitions="160,*,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="服务端口" VerticalAlignment="Center"/>
                        <NumberBox Grid.Column="1" Value="{x:Bind ViewModel.Port, Mode=TwoWay}"
                                   Minimum="1" Maximum="65535" SpinButtonPlacementMode="Compact"/>
                    </Grid>
                    <Grid ColumnDefinitions="160,*,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="多播组" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{x:Bind ViewModel.MulticastGroup, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                    <Grid ColumnDefinitions="160,*,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="接收保存目录" VerticalAlignment="Center"/>
                        <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Text="{x:Bind ViewModel.Destination, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="1" Content="浏览..." Click="OnBrowseDestinationClick" Margin="8,0,0,0"/>
                        </Grid>
                    </Grid>
                    <Grid ColumnDefinitions="160,*,Auto" VerticalAlignment="Center">
                        <StackPanel Grid.Column="0" Spacing="1">
                            <TextBlock Text="接收 PIN 码" VerticalAlignment="Center"/>
                            <TextBlock Text="对方发送文件时必须输入此 PIN 才能发起请求。" Opacity="0.5" FontSize="11"/>
                        </StackPanel>
                        <Grid Grid.Column="1" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                            <PasswordBox x:Name="PinPasswordBox" Grid.Column="0" Height="32"
                                         PlaceholderText="留空 = 不启用，任何设备都可直接发送"
                                         PasswordChanged="OnPinPasswordChanged"/>
                            <TextBox x:Name="PinVisibleBox" Grid.Column="0" Height="32" Visibility="Collapsed"
                                     TextChanged="OnPinTextChanged"/>
                            <Button Grid.Column="1" x:Name="PinToggleBtn" Width="36" Height="32"
                                    Padding="0" Margin="8,0,0,0" Click="OnPinToggleClick"
                                    ToolTipService.ToolTip="显示/隐藏">
                                <FontIcon Glyph="&#xE8D4;" FontSize="16"/>
                            </Button>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 外观 -->
            <Border Padding="18,14" CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="14">
                    <TextBlock Text="外观" FontSize="14" FontWeight="SemiBold" Opacity="0.85"/>
                    <Grid ColumnDefinitions="160,*,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="主题模式" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <RadioButtons SelectedIndex="{x:Bind ViewModel.ThemeMode, Mode=TwoWay}" MaxColumns="3">
                                <RadioButton Content="跟随系统"/>
                                <RadioButton Content="浅色"/>
                                <RadioButton Content="深色"/>
                            </RadioButtons>
                            <TextBlock Text="保存后立即切换；下次启动保留偏好。" Opacity="0.6" FontSize="12"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 系统 -->
            <Border Padding="18,14" CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="14">
                    <TextBlock Text="系统" FontSize="14" FontWeight="SemiBold" Opacity="0.85"/>
                    <Grid ColumnDefinitions="160,*,Auto" VerticalAlignment="Center">
                        <StackPanel Grid.Column="0" Spacing="1">
                            <TextBlock Text="开机自启" VerticalAlignment="Center"/>
                            <TextBlock Text="登录 Windows 后自动启动 LocalSend PC。" Opacity="0.5" FontSize="11"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.AutoLaunchEnabled, Mode=TwoWay}"
                                          OnContent="开" OffContent="关"/>
                            <TextBlock Text="{x:Bind ViewModel.AutoLaunchInfo, Mode=OneWay}" Opacity="0.65" FontSize="12"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 操作栏 -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.SaveStatus, Mode=OneWay}"
                           VerticalAlignment="Center" Opacity="0.7"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="保存更改"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            Foreground="{ThemeResource TextOnAccentFillColorDefaultBrush}"
                            Padding="20,8" CornerRadius="8"
                            Command="{x:Bind ViewModel.SaveCommand}"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
