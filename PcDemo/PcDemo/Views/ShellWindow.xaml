<?xml version="1.0" encoding="utf-8"?>
<!-- 主窗口：顶部标题栏（图标+应用名）+ NavigationView（接收/设置）+ Frame 内容区 -->
<Window
    x:Class="PcDemo.Views.ShellWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="快传">

    <Grid x:Name="RootGrid" RowDefinitions="32,*">
        <!-- 自定义标题栏：汉堡按钮（收起/展开侧边栏）+ 应用图标 + 名称 -->
        <Grid x:Name="AppTitleBar" Grid.Row="0"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              Padding="4,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- 侧边栏收起/展开按钮（最左）：32×32，点击区域 = 系统按钮高度 -->
            <Button x:Name="PaneToggleButton" Grid.Column="0"
                    Click="OnPaneToggleClick"
                    AutomationProperties.Name="收起或展开侧边栏"
                    ToolTipService.ToolTip="收起/展开侧边栏"
                    Background="Transparent" BorderThickness="0"
                    Width="32" Height="32" Padding="0">
                <Viewbox Width="16" Height="16">
                    <SymbolIcon Symbol="GlobalNavigationButton"/>
                </Viewbox>
            </Button>
            <Image Grid.Column="1" Source="Assets/Square44x44Logo.targetsize-24_altform-unplated.png"
                   AutomationProperties.Name="快传"
                   Width="16" Height="16" Margin="4,0,0,0" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="快传" FontSize="12" FontWeight="SemiBold"
                       Margin="8,0,0,0" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
        </Grid>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            PaneDisplayMode="Left"
            OpenPaneLength="140"
            CompactPaneLength="48"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            SelectionChanged="OnSelectionChanged">
            <NavigationView.Resources>
                <!-- 侧边栏背景：与标题栏同色，形成一条通到底的色条。

                     两个坑（都已踩过）：
                     1) 键名必须是 NavigationViewDefaultPaneBackground —— 这是 WinUI 3 模板里
                        真正被 `Background="{ThemeResource NavigationViewDefaultPaneBackground}"`
                        消费的那个键（默认值 AcrylicInAppFillColorDefaultBrush）。原来的
                        NavigationViewPaneBackground 在 generic.xaml 里根本不存在，属于死资源：
                        里面的 {ThemeResource} 永远不会被解析，所以既不生效也不会报错。
                     2) 颜色键是 LayerFillColorDefault（没有 Color 后缀）。写成
                        LayerFillColorDefaultColor 会 KeyNotFound；之前没崩只是因为踩了坑 1，
                        一旦该画刷被模板消费就会在启动时抛 XamlParseException。 -->
                <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground"
                                 Color="{ThemeResource LayerFillColorDefault}"
                                 Opacity="1.0"/>
            </NavigationView.Resources>

            <NavigationView.MenuItems>
                <NavigationViewItem Tag="Receive" Icon="Download" Content="接收"/>
                <NavigationViewItem Tag="Send" Icon="Send" Content="发送"/>
                <NavigationViewItem Tag="DeviceList" Icon="People" Content="设备管理"/>
                <NavigationViewItem Tag="History" Icon="Clock" Content="历史记录"/>
            </NavigationView.MenuItems>

            <!-- 底部 footer 菜单项（独立于顶部 MenuItems，会贴在侧边栏底部）-->
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Tag="Settings" Icon="Setting" Content="设置"/>
            </NavigationView.FooterMenuItems>

            <!-- Frame 作为 NavigationView 的隐式 Content（内容区），
                 用稍不同的 LayerOnMicaBaseAltFillColorTransparentBrush 形成与侧边栏的色差 -->
            <Frame x:Name="ContentFrame"
                   Background="{ThemeResource LayerOnMicaBaseAltFillColorTransparentBrush}">
                <!-- 页面切换过渡：横向滑入 + 淡入（默认无过渡会生硬跳变） -->
                <Frame.ContentTransitions>
                    <TransitionCollection>
                        <NavigationThemeTransition>
                            <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                                <SlideNavigationTransitionInfo Effect="FromRight"/>
                            </NavigationThemeTransition.DefaultNavigationTransitionInfo>
                        </NavigationThemeTransition>
                    </TransitionCollection>
                </Frame.ContentTransitions>
            </Frame>
        </NavigationView>
    </Grid>
</Window>
