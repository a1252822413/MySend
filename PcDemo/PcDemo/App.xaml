<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="PcDemo.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ② 双保险：把内置 accent 画刷本身也钉成品牌绿。
                 ①（下方调色板）走的是"派生色 → 画刷"的间接链路；这里直接覆盖按钮/开关/
                 选中态/进度环实际消费的那几个画刷，即使调色板某处被系统值抢先，
                 主强调色也不会回落成系统蓝。两个主题都给同一品牌绿，保证观感一致。 -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#16A34A" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#16A34A" Opacity="0.9" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#16A34A" Opacity="0.8" />
                    <!-- 次级表面（chip / 胶囊 / 状态条 / 分段控件容器）。
                         WinUI 原生 ControlFillColorSecondaryBrush 在亮色主题下是 50% 白叠加，
                         压在 70% 白的卡片上等于看不见 —— 截图里那些"胶囊/状态条"全成了裸文字、
                         只剩内边距。这里改用深色微叠加，保证在两个主题下都真的看得见。 -->
                    <SolidColorBrush x:Key="ChipFillBrush" Color="#0F000000" />
                    <SolidColorBrush x:Key="ChipStrokeBrush" Color="#17000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#16A34A" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#16A34A" Opacity="0.9" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#16A34A" Opacity="0.8" />
                    <SolidColorBrush x:Key="ChipFillBrush" Color="#1AFFFFFF" />
                    <SolidColorBrush x:Key="ChipStrokeBrush" Color="#2EFFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- ① 品牌绿调色板（LocalSend 识别色）

                 重要（踩过的坑）：只覆盖 SystemAccentColor 是**无效**的。
                 WinUI 的强调色画刷不直接引用基色，而是引用系统派生出的明暗档：
                   · 亮色主题 AccentFillColorDefaultBrush = SystemAccentColorLight2
                   · 暗色主题 AccentFillColorDefaultBrush = SystemAccentColorDark1
                 而 Light1..3 / Dark1..3 是 Windows 按"系统主题色"预先算好的快照，
                 覆盖基色并不会让它们重算 —— 这正是"改了品牌色却只有零星几处变绿、
                 按钮/选中态/进度环仍是系统蓝"的原因。
                 官方文档示例只给了基色一行，容易误导；要让品牌色真正生效必须整套七个值一起覆盖。

                 取值策略：Light2 与 Dark1 才是两个主题下真正的强调填充，二者都取品牌绿，
                 保证两个主题强调色一致；其余档位给协调的深浅阶梯供其他 accent 资源使用。 -->
            <Color x:Key="SystemAccentColor">#16A34A</Color>
            <Color x:Key="SystemAccentColorLight1">#15803D</Color>
            <Color x:Key="SystemAccentColorLight2">#16A34A</Color>
            <Color x:Key="SystemAccentColorLight3">#1CB454</Color>
            <Color x:Key="SystemAccentColorDark1">#16A34A</Color>
            <Color x:Key="SystemAccentColorDark2">#12833C</Color>
            <Color x:Key="SystemAccentColorDark3">#0E6B31</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
